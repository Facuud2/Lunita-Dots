node_modules/
@girs/
__pycache__/
*.pyc


# Backups y archivos temporales
*.bak
*.tmp
*~


# Estado local del gestor de temas
.lunita-theme

# Marcadores y lugares de usuario generados dinámicamente
themes/*/.config/gtk-3.0/bookmarks
themes/*/.local/share/user-places.xbel

# Configuración exclusiva de hardware del usuario y archivos generados en caliente
**/hypr/modules/monitors.lua
**/hypr/current_wallpaper.png
**/hypr/scripts/wvkbd-colors.env
core/.config/hypr/monitors.lua
core/.config/hypr/hyprlock-colors.conf
core/.config/hypr/modules/colors.lua
core/prelock/palette.conf

# Paletas dinámicas generadas por Matugen en lunita-default
themes/*/.config/kitty/colors-matugen.conf
themes/lunita-default/.config/nvim/lua/colors.lua
themes/lunita-default/.config/gtk-3.0/gtk.css
themes/lunita-default/.config/gtk-4.0/gtk.css
themes/lunita-default/.config/qt6ct/colors/lunita.conf
themes/lunita-default/.config/qt6ct/qss/lunita.qss
themes/lunita-default/.config/vesktop/themes/lunita.theme.css
themes/lunita-default/.config/kdeglobals
themes/lunita-default/.local/share/color-schemes/Lunita.colors
# Paletas dinámicas generadas por Matugen y scripts de sincronización
themes/*/.config/kitty/colors-matugen.conf
themes/*/.config/nvim/lua/colors.lua
themes/*/.config/gtk-3.0/gtk.css
themes/*/.config/gtk-4.0/gtk.css
themes/*/.config/qt6ct/colors/lunita.conf
themes/*/.config/qt6ct/qss/lunita.qss
themes/*/.config/vesktop/themes/lunita.theme.css
themes/*/.config/kdeglobals
themes/*/.local/share/color-schemes/Lunita.colors
.lunita-theme
