/* Lunita-Dots Qt6 Stylesheet generated by Matugen */
QWidget {
    color: #{{colors.on_surface.default.hex_stripped}};
}

QMainWindow, QDialog {
    background-color: #{{colors.surface.default.hex_stripped}};
}

QToolBar {
    background-color: #{{colors.surface.default.hex_stripped}};
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolButton {
    background: transparent;
    border-radius: 6px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: #{{colors.surface_container_high.default.hex_stripped}};
}

QToolButton:pressed {
    background-color: #{{colors.primary_container.default.hex_stripped}};
}

QLineEdit, QComboBox {
    background-color: #{{colors.surface_container.default.hex_stripped}};
    color: #{{colors.on_surface.default.hex_stripped}};
    border: 1px solid #{{colors.outline_variant.default.hex_stripped}};
    border-radius: 8px;
    padding: 4px 8px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #{{colors.primary.default.hex_stripped}};
}

QHeaderView::section {
    background-color: #{{colors.surface_container.default.hex_stripped}};
    color: #{{colors.on_surface.default.hex_stripped}};
    border: none;
    border-right: 1px solid #{{colors.surface_container_high.default.hex_stripped}};
    padding: 6px 12px;
    font-weight: bold;
}

QTreeView, QListView, QTableView,
KItemListContainer, KItemListView, KFilePlacesView,
DolphinViewContainer {
    background-color: #{{colors.surface.default.hex_stripped}};
    alternate-background-color: #{{colors.surface.default.hex_stripped}};
    color: #{{colors.on_surface.default.hex_stripped}};
    border: none;
    selection-background-color: #{{colors.primary.default.hex_stripped}};
    selection-color: #{{colors.on_primary.default.hex_stripped}};
    outline: none;
}

QTreeView::item:hover, QListView::item:hover {
    background-color: #{{colors.surface_container.default.hex_stripped}};
    border-radius: 6px;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: #{{colors.primary.default.hex_stripped}};
    color: #{{colors.on_primary.default.hex_stripped}};
    border-radius: 6px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #{{colors.outline_variant.default.hex_stripped}};
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #{{colors.primary.default.hex_stripped}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QStatusBar {
    background-color: #{{colors.surface_container.default.hex_stripped}};
    color: #{{colors.on_surface_variant.default.hex_stripped}};
}
