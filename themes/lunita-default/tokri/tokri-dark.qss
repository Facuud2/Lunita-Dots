/* ==============================================================================
 * 🌙 Tokri — Lunita Default (Dark / Material You)
 * Lunita-Dots · themes/lunita-default/tokri/tokri-dark.qss
 * ============================================================================== */

* {
    font-family: "JetBrainsMono Nerd Font", monospace;
    outline: none;
}

/* ── Ventana principal ── */
QMainWindow,
QMainWindow > QWidget#centralwidget,
QWidget#centralwidget {
    background: transparent;
    background-color: transparent;
    border: none;
    color: #CDD6F4;
}

QWidget#centralwidget {
    padding: 0px;
}

QMenuBar {
    max-height: 0px;
    min-height: 0px;
    border: none;
    background: transparent;
}

/* ── Lista de elementos (grilla de miniaturas) ── */
QListView {
    background-color: transparent;
    color: #CDD6F4;
    selection-color: #FFFFFF;
    selection-background-color: rgba(181, 136, 247, 0.40);
    border: none;
    padding: 4px;
    font-size: 9pt;
}

QListView::item {
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
}

QListView::item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.10);
}

QListView::item:selected {
    background-color: rgba(181, 136, 247, 0.30);
    border: 1px solid #B588F7;
}

/* ── Barra de herramientas / Botones ── */
QPushButton {
    background-color: #1E1E2E;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    color: #CDD6F4;
    padding: 4px 10px;
}

QPushButton:hover {
    background-color: rgba(181, 136, 247, 0.25);
    border-color: #B588F7;
}

QPushButton:pressed {
    background-color: #B588F7;
    color: #FFFFFF;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.20);
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #B588F7;
}
