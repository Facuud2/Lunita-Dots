;; ====================================================================
;; EWW MAIN CONFIGURATION
;; Contains:
;; 1. Anime Sidebar Widget (left panel with dynamic Matugen anime cards)
;; 2. Music Player Widget (dynamic Matugen theme with Cava visualizer)
;; ====================================================================

;; ── Streams & Data Sources ───────────────────────────────────────────
(deflisten anime_data
  :initial '{"img1":"~/.config/eww/assets/placeholder.png","img2":"~/.config/eww/assets/placeholder.png","img3":"~/.config/eww/assets/placeholder.png","img4":"~/.config/eww/assets/placeholder.png","img5":"~/.config/eww/assets/placeholder.png","img6":"~/.config/eww/assets/placeholder.png","nsfw":false,"nsfw_label":"OFF","nsfw_class":"inactive","count":0,"source":"Konachan"}'
  "python3 ~/.config/eww/scripts/konachan.py watch")

(deflisten cava_output :initial "▁▁▁▁▁▁▁▁▁▁▁▁▁▁"
  "scripts/cava.sh")

(deflisten media :initial '{"status":"Stopped","player":"","title":"No Music Playing","artist":"","cover":"~/.config/eww/assets/default_cover.png","has_media":false}'
  "scripts/media.py")

(deflisten wallpaper_theme :initial ""
  "scripts/watch_wallpaper.sh")

;; ====================================================================
;; 1. ANIME SIDEBAR WIDGETS
;; ====================================================================
(defwidget anime-card [path]
  (box :class "card-outer"
       :orientation "vertical"
       :space-evenly false
       :visible {path != ""}
    (overlay
      (box :class "card-img-container"
        (image :class "card-img"
               :path path
               :image-width 340
               :image-height 210))
      (button :class "card-action-btn"
              :valign "start"
              :halign "end"
              :onclick "xdg-open '${path}' &"
              :tooltip "Open full image"
        ""))))

(defwidget anime-sidebar-widget []
  (box :class "anime-sidebar-container"
       :orientation "vertical"
       :space-evenly false
       :vexpand true

    ;; Header: Navigation Chips
    (box :class "sidebar-header"
         :orientation "horizontal"
         :space-evenly false
         :spacing 10
      (box :class "tab-chip inactive"
           :space-evenly false
           :spacing 6
        (label :class "chip-icon" :text "󰚩")
        (label :class "chip-text" :text "Intelligence"))
      (box :class "tab-chip active"
           :space-evenly false
           :spacing 6
        (label :class "chip-icon" :text "󰄛")
        (label :class "chip-text" :text "Anime")))

    ;; Scrollable Card Feed
    (scroll :class "cards-scroll-area"
            :vscroll true
            :hscroll false
            :vexpand true
      (box :class "cards-feed-box"
           :orientation "vertical"
           :space-evenly false
           :spacing 16
        (anime-card :path {anime_data.img1})
        (anime-card :path {anime_data.img2})
        (anime-card :path {anime_data.img3})
        (anime-card :path {anime_data.img4})
        (anime-card :path {anime_data.img5})
        (anime-card :path {anime_data.img6})

        ;; Scroll / Next button at the bottom of feed
        (button :class "scroll-footer-btn"
                :onclick "python3 ~/.config/eww/scripts/konachan.py next &"
                :tooltip "Load more anime cards"
          (box :space-evenly false :spacing 8 :halign "center"
            (label :class "scroll-btn-icon" :text "")
            (label :class "scroll-btn-label" :text "Scroll to Bottom")))))

    ;; Footer Command Input Bar (aesthetic, non-focus-stealing)
    (box :class "footer-cmd-bar"
         :orientation "horizontal"
         :space-evenly false
      (label :class "footer-cmd-text"
             :hexpand true
             :halign "start"
             :text "Enter tags, or \"/\" for commands")
      (button :class "footer-cmd-arrow"
              :onclick "python3 ~/.config/eww/scripts/konachan.py fetch &"
              :tooltip "Fetch new batch"
        ""))

    ;; Footer Status & Control Bar
    (box :class "footer-status-bar"
         :orientation "horizontal"
         :space-evenly false
         :spacing 12

      ;; Source dot + name
      (box :class "source-indicator"
           :space-evenly false
           :spacing 6
        (label :class "status-dot" :text "•")
        (label :class "source-name" :text {anime_data.source}))

      ;; NSFW Toggle
      (button :class "nsfw-toggle-btn"
              :onclick "python3 ~/.config/eww/scripts/konachan.py toggle_nsfw &"
              :tooltip "Toggle Safe / NSFW"
        (box :space-evenly false :spacing 6
          (label :class "nsfw-text" :text "Allow NSFW")
          (label :class "nsfw-pill ${anime_data.nsfw_class}" :text {anime_data.nsfw_label})))

      ;; Quick command links
      (button :class "quick-cmd-btn"
              :onclick "python3 ~/.config/eww/scripts/konachan.py next &"
              :tooltip "Rotate cards"
        "/mode")

      (button :class "quick-cmd-btn"
              :onclick "python3 ~/.config/eww/scripts/konachan.py fetch &"
              :tooltip "Fetch newest"
        "/clear"))))

;; ====================================================================
;; 2. MUSIC PLAYER WIDGET
;; ====================================================================
(defwidget music_player_widget []
  (box :class "music-player-window"
       :orientation "vertical"
       :space-evenly false
       :tooltip "${wallpaper_theme}"

    ;; Top section: Cover Art + Info (Stream badge, title, artist)
    (box :class "header-section"
         :orientation "horizontal"
         :space-evenly false
         :spacing 16
         :valign "start"

      ;; Cover art (scaled cleanly with ffmpeg)
      (box :class "cover-art-box"
           :valign "center"
           :halign "center"
        (image :class "cover-art-img"
               :path {media.cover}
               :image-width 96
               :image-height 96))

      ;; Info column: Stream Badge + Song Title + Artist
      (box :class "meta-box"
           :orientation "vertical"
           :space-evenly false
           :spacing 6
           :valign "center"

        ;; Stream source pill badge
        (box :class "badge-row"
             :space-evenly false
          (label :class "stream-badge"
                 :visible {media.has_media && media.player != ""}
                 :text {media.player})
          (label :class "stream-badge offline"
                 :visible {!media.has_media || media.player == ""}
                 :text "Idle"))

        ;; Song Title
        (label :class "track-title"
               :limit-width 18
               :text {media.has_media ? media.title : "No Music Playing"}
               :tooltip {media.has_media ? media.title : ""})

        ;; Artist name
        (label :class "track-artist"
               :limit-width 20
               :visible {media.has_media && media.artist != ""}
               :text {media.artist})))

    ;; Middle section: Cava audio visualizer
    (box :class "cava-container"
         :halign "center"
         :valign "center"
         :vexpand true
      (label :class "cava-bar"
             :text cava_output))

    ;; Bottom section: Playback controls
    (box :class "controls-container"
         :orientation "horizontal"
         :space-evenly false
         :spacing 20
         :halign "center"
         :valign "end"

      ;; Previous track
      (button :class "ctrl-btn"
              :onclick "playerctl previous"
              :tooltip "Previous track"
              "|‹")

      ;; Play / Pause toggle
      (button :class "ctrl-btn play-btn"
              :onclick "playerctl play-pause"
              :tooltip "Play / Pause"
              {media.status == "Playing" ? "⏸" : "▶"})

      ;; Next track
      (button :class "ctrl-btn"
              :onclick "playerctl next"
              :tooltip "Next track"
              "›|"))))

;; ====================================================================
;; WINDOW DEFINITIONS
;; ====================================================================

;; Anime Sidebar Window (Monitor 0: DP-1)
(defwindow anime_sidebar
  :monitor 0
  :geometry (geometry
              :x "20px"
              :y "20px"
              :width "380px"
              :height "994px"
              :anchor "top left")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (anime-sidebar-widget))

;; Music Player Window (Monitor 0: DP-1)
(defwindow music_player_0
  :monitor 0
  :geometry (geometry :x "20px"
                      :y "20px"
                      :anchor "top right")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (music_player_widget))

;; Music Player Window (Monitor 1: HDMI-A-1)
(defwindow music_player_1
  :monitor 1
  :geometry (geometry :x "20px"
                      :y "20px"
                      :anchor "top right")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (music_player_widget))
