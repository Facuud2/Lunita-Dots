#!/usr/bin/env bash
#
# hyprquickpaper launcher wrapper with debounce & toggle support
#

# Debounce rapid keypresses (within 350ms) to prevent multiple simultaneous launches
COOLDOWN_FILE="/tmp/hyprquickpaper_cooldown"
NOW=$(date +%s%3N)
if [ -f "$COOLDOWN_FILE" ]; then
    LAST=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)
    DIFF=$(( NOW - LAST ))
    if [ "$DIFF" -ge 0 ] && [ "$DIFF" -lt 350 ]; then
        exit 0
    fi
fi
echo "$NOW" > "$COOLDOWN_FILE"

# If already running, kill the active instance cleanly (toggle behavior)
PID=$(pgrep -f "[q]s -n -c hyprquickpaper" | head -n 1)
if [ -n "$PID" ]; then
    kill "$PID" 2>/dev/null
    exit 0
fi

# Launch Quickshell with -n (no-duplicate protection)
exec qs -n -c hyprquickpaper "$@"
