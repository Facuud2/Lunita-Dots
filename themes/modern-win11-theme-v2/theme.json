{
  "id": "modern-win11-theme-v2",
  "name": "Modern Win 11 Theme V2",
  "version": "2.0.0",
  "author": "Facuud2 & Lunita Core Team",
  "description": "Tema de nueva generación inspirado en Astraeus y Windows 11 Fluent Design V2 con material Acrylic / Mica, Dynamic Island líquida superior con física de resorte (Notch y Long Pill con letras sincronizadas), Dashboard deslizable con navegación por Rail, controles de sistema, herramientas rápidas y Dock acrílico flotante, implementado 100% sobre Quickshell (Qt6/QML).",
  "archetype": "Fluent Acrylic (Win11)",
  "components": {
    "bar": "quickshell-astraeus-island",
    "dock": "quickshell-fluent-dock",
    "launcher": "quickshell-fluent-startmenu",
    "powermenu": "wlogout-fluent-glass",
    "notifications": "quickshell-fluent-notifications",
    "widgets": "quickshell-widgets",
    "clipboard": "rofi-cliphist",
    "color_engine": "fluent-mica",
    "wallpaper_picker": "hyprquickpaper",
    "terminal": "kitty-win11",
    "file_manager": "dolphin-win11-acrylic",
    "cursor": "Bibata-Modern-Ice",
    "shell": "zsh-pills"
  },
  "engine": "fluent-mica",
  "typography": {
    "interface": "Segoe UI Variable Text, Segoe UI, Inter",
    "display": "Segoe UI Variable Display, Segoe UI",
    "monospace": "JetBrainsMono Nerd Font",
    "size": 10
  },
  "assets": {
    "icon_theme": "Fluent-yellow-dark",
    "cursor_theme": "Bibata-Modern-Ice",
    "cursor_size": 24
  },
