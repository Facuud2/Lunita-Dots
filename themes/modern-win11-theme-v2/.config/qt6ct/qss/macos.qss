/* 🍎 macOS Cupertino / Finder Light Styling for Qt6 & Dolphin */

* {
    font-family: "SF Pro Display", "SF Pro Text", "Inter", "Cantarell", -apple-system, sans-serif;
    font-size: 13px;
    outline: none;
}

/* ── Main Window & Dialogs ── */
QMainWindow, QDialog, QWidget#DolphinViewContainer {
    background-color: #F5F7FB;
    color: #1D1D1F;
}

/* ── Dolphin Finder Sidebar (Places Panel) ── */
QDockWidget {
    background-color: #EBEFF5;
    border: none;
    border-right: 1px solid rgba(0, 0, 0, 0.08);
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #EBEFF5;
    padding: 8px 10px 4px 10px;
    font-weight: 700;
    color: #8E8E93;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

/* Sidebar List View */
QDockWidget QTreeView, QDockWidget QListView {
    background-color: #EBEFF5;
    border: none;
    outline: none;
    color: #1D1D1F;
    padding: 4px 6px;
}

QDockWidget QTreeView::item, QDockWidget QListView::item {
    height: 30px;
    padding: 2px 8px;
    border-radius: 7px;
    margin: 1px 2px;
    color: #2C2C2E;
    font-weight: 450;
}

QDockWidget QTreeView::item:hover, QDockWidget QListView::item:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: #1D1D1F;
}

QDockWidget QTreeView::item:selected, QDockWidget QListView::item:selected {
    background-color: #DDE3ED;
    color: #1D1D1F;
    font-weight: 600;
}

QDockWidget QTreeView::item:selected:!active, QDockWidget QListView::item:selected:!active {
    background-color: #E4E9F2;
    color: #1D1D1F;
}

/* ── Main File View (Grid / List / Tree) ── */
QTreeView, QListView, QTableView {
    background-color: #FFFFFF;
    border: none;
    outline: none;
    color: #1D1D1F;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
    show-decoration-selected: 1;
    padding: 6px;
}

QTreeView::item, QListView::item {
    padding: 4px 8px;
    border-radius: 6px;
    margin: 2px;
    color: #1D1D1F;
}

QTreeView::item:hover, QListView::item:hover {
    background-color: rgba(0, 122, 255, 0.08);
    color: #1D1D1F;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: #007AFF;
    color: #FFFFFF;
    font-weight: 500;
}

QTreeView::item:selected:!active, QListView::item:selected:!active {
    background-color: rgba(0, 122, 255, 0.50);
    color: #FFFFFF;
}

/* ── Column Header Views (Finder Details mode) ── */
QHeaderView::section {
    background-color: #F5F7FB;
    color: #8E8E93;
    padding: 5px 10px;
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    border-right: 1px solid rgba(0, 0, 0, 0.04);
    font-size: 11px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: rgba(0, 0, 0, 0.04);
    color: #1D1D1F;
}

/* ── Finder Toolbar & Navigation Buttons ── */
QToolBar {
    background-color: #F1F3F7;
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    spacing: 6px;
    padding: 6px 12px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    color: #3A3A3C;
    font-weight: 500;
}

QToolButton:hover {
    background-color: rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.04);
    color: #1D1D1F;
}

QToolButton:pressed {
    background-color: rgba(0, 0, 0, 0.12);
}

QToolButton:checked {
    background-color: #FFFFFF;
    border-color: rgba(0, 0, 0, 0.12);
    color: #007AFF;
    font-weight: 600;
}

/* ── Finder URL Navigator / Path Bar (Pill style) ── */
QLineEdit, QWidget#urlNavigator {
    background-color: rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 7px;
    padding: 4px 10px;
    color: #1D1D1F;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    background-color: #FFFFFF;
    border: 1.5px solid #007AFF;
}

/* Search bar styling */
QLineEdit[echoMode="0"] {
    padding-left: 8px;
}

/* ── Segmented Tab Bar (macOS Finder Tabs) ── */
QTabWidget::pane {
    border: none;
    background-color: #FFFFFF;
}

QTabBar {
    background-color: #F1F3F7;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    padding: 3px 6px;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: transparent;
    color: #6E6E73;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 14px;
    margin: 1px 3px;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: rgba(0, 0, 0, 0.04);
    color: #1D1D1F;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid rgba(0, 0, 0, 0.10);
    font-weight: 600;
}

/* ── Buttons (PushButtons) ── */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 6px;
    padding: 5px 14px;
    color: #1D1D1F;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F5F7FB;
    border-color: rgba(0, 0, 0, 0.18);
}

QPushButton:pressed {
    background-color: #E8EDF5;
}

QPushButton:default, QPushButton#primaryButton {
    background-color: #007AFF;
    color: #FFFFFF;
    border-color: #0062CC;
}

QPushButton:default:hover, QPushButton#primaryButton:hover {
    background-color: #006FE6;
}

/* ── Status Bar ── */
QStatusBar {
    background-color: #F1F3F7;
    color: #8E8E93;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    font-size: 11px;
    padding: 2px 8px;
}

/* ── Scrollbars (macOS Overlay Thin Style) ── */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.20);
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.40);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.20);
    border-radius: 4px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 0.40);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
}

/* ── Menus & Context Popups ── */
QMenu {
    background-color: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    color: #1D1D1F;
    padding: 6px 22px;
    border-radius: 5px;
    margin: 1px 2px;
}

QMenu::item:selected {
    background-color: #007AFF;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: rgba(0, 0, 0, 0.08);
    margin: 4px 6px;
}

/* ── Tooltips ── */
QToolTip {
    background-color: #1D1D1F;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
}
