#!/usr/bin/env python3
import os
import sys

PIPE_PATH = "/tmp/lunita_widgets_ipc.pipe"
cmd = sys.argv[1] if len(sys.argv) > 1 else "toggle_edit"

try:
    if os.path.exists(PIPE_PATH):
        fd = os.open(PIPE_PATH, os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, f"{cmd}\n".encode())
        os.close(fd)
except Exception:
    pass
