#!/usr/bin/env bash
# ==============================================================================
# 🚀 LUNITA LAUNCHER WRAPPER
# Gestor e invocador reactivo para el App Launcher de macOS en Quickshell
# ==============================================================================

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

ACTION="${1:-toggle}"

LAUNCHER_PATH="$HOME/.config/quickshell/launcher"
if [ ! -d "$LAUNCHER_PATH" ]; then
    LAUNCHER_PATH="$DOTS_DIR/themes/macOS-Theme/quickshell/launcher"
fi

# 1. Si el launcher ya está en ejecución, enviar comando IPC directamente
if pgrep -f "quickshell.*launcher" >/dev/null 2>&1; then
    quickshell -p "$LAUNCHER_PATH" ipc call launcher "$ACTION" 2>/dev/null || quickshell ipc call launcher "$ACTION" 2>/dev/null || true
    exit 0
fi

# 2. Si no está en ejecución, iniciarlo en modo daemon
quickshell -d -n -p "$LAUNCHER_PATH"

# Pequeña espera para inicializar socket IPC y abrir
sleep 0.15
quickshell -p "$LAUNCHER_PATH" ipc call launcher "$ACTION" 2>/dev/null || quickshell ipc call launcher "$ACTION" 2>/dev/null || true
