#!/usr/bin/env bash
# ==============================================================================
# 🍎 LUNITA TOKRI DAEMON & CONTROLLER
# Gestor de inicio automático, tematización macOS y control de Tokri
# Lunita-Dots · scripts/lunita-tokri
# ==============================================================================

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

USER_UID="$(id -u)"
NATIVE_SOCKET="/tmp/com.ysuraj.Tokri.ipc"
FLATPAK_SOCKET="/run/user/${USER_UID}/.flatpak/com.ysuraj.Tokri/tmp/com.ysuraj.Tokri.ipc"

get_active_qss() {
    local color_scheme="dark"
    if [ -f "$HOME/.config/lunita/color_scheme" ]; then
        color_scheme="$(cat "$HOME/.config/lunita/color_scheme" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"
    fi

    if [[ "$color_scheme" == *"light"* ]]; then
        echo "$DOTS_DIR/themes/macOS-Theme/tokri/tokri-light.qss"
    else
        echo "$DOTS_DIR/themes/macOS-Theme/tokri/tokri-dark.qss"
    fi
}

get_socket() {
    if [ -S "$NATIVE_SOCKET" ]; then
        echo "$NATIVE_SOCKET"
    elif [ -S "$FLATPAK_SOCKET" ]; then
        echo "$FLATPAK_SOCKET"
    else
        echo ""
    fi
}

is_running() {
    pgrep -f "bin/Tokri|^Tokri" >/dev/null 2>&1 || (command -v flatpak &>/dev/null && flatpak ps 2>/dev/null | grep -q "com.ysuraj.Tokri")
}

is_window_mapped() {
    if command -v hyprctl &>/dev/null; then
        hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "Tokri" and .mapped == true)' >/dev/null 2>&1
    else
        return 1
    fi
}

send_socket_cmd() {
    local cmd="${1:-wake}"
    local sock
    sock="$(get_socket)"
    if [ -n "$sock" ] && [ -S "$sock" ]; then
        python3 -c "import socket; s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(0.5); s.connect('${sock}'); s.sendall(b'${cmd}\n'); s.close()" 2>/dev/null || return 1
        return 0
    fi
    return 1
}

cmd_start() {
    if is_running; then
        return 0
    fi

    local qss_path
    qss_path="$(get_active_qss)"

    local exec_cmd=""
    if [ -x "$HOME/.local/bin/Tokri" ]; then
        exec_cmd="$HOME/.local/bin/Tokri --start-hidden -stylesheet=\"$qss_path\""
    else
        exec_cmd="flatpak run --no-documents-portal com.ysuraj.Tokri -stylesheet=\"$qss_path\""
    fi

    nohup bash -c "$exec_cmd" >/dev/null 2>&1 &
}

cmd_stop() {
    pkill -9 -f "bin/Tokri|com.ysuraj.Tokri" >/dev/null 2>&1 || true
    if command -v flatpak &>/dev/null; then
        flatpak kill com.ysuraj.Tokri >/dev/null 2>&1 || true
    fi
    rm -f /tmp/com.ysuraj.Tokri.lock /tmp/com.ysuraj.Tokri.ipc 2>/dev/null || true
}

cmd_wake() {
    if ! is_running; then
        cmd_start
        sleep 0.2
    fi
    send_socket_cmd "wake"
}

cmd_sleep() {
    send_socket_cmd "sleep"
}

cmd_toggle() {
    if ! is_running; then
        cmd_start
        sleep 0.2
        send_socket_cmd "wake"
    else
        send_socket_cmd "toggle"
    fi
}

cmd_reload_theme() {
    if is_running; then
        local was_mapped=false
        if is_window_mapped; then
            was_mapped=true
        fi
        cmd_stop
        sleep 0.3
        cmd_start
        if [ "$was_mapped" = true ]; then
            sleep 0.2
            cmd_wake
        fi
    fi
}

cmd_status() {
    if is_running; then
        echo "Tokri está ejecutándose [ACTIVO]."
        if is_window_mapped; then
            echo "Estado ventana: Visible / Desplegada"
        else
            echo "Estado ventana: Oculta en bandeja (esperando arrastre o atajo)"
        fi
        local sock
        sock="$(get_socket)"
        echo "Socket activo: ${sock:-Ninguno}"
        echo "Estilo activo: $(get_active_qss)"
    else
        echo "Tokri está detenido [INACTIVO]."
    fi
}

case "${1:-toggle}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_stop
        sleep 0.3
        cmd_start
        ;;
    toggle)
        cmd_toggle
        ;;
    wake|open|show|summon)
        cmd_wake
        ;;
    sleep|hide)
        cmd_sleep
        ;;
    reload-theme)
        cmd_reload_theme
        ;;
    status)
        cmd_status
        ;;
    *)
        echo "Uso: lunita-tokri {start|stop|restart|toggle|wake|sleep|reload-theme|status}"
        exit 1
        ;;
esac
