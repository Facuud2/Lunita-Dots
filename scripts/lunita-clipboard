#!/usr/bin/env bash
# ==============================================================================
# 📋 LUNITA CLIPBOARD WRAPPER
# Gestor e invocador reactivo para el Clipboard macOS en Quickshell
# ==============================================================================

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

ACTION="${1:-toggle}"

CLIPBOARD_PATH="$HOME/.config/quickshell/clipboard"
if [ ! -d "$CLIPBOARD_PATH" ]; then
    CLIPBOARD_PATH="$DOTS_DIR/themes/macOS-Theme/quickshell/clipboard"
fi

# 1. Si el portapapeles ya está en ejecución, enviar comando IPC directamente
if pgrep -f "quickshell.*clipboard" >/dev/null 2>&1; then
    quickshell -p "$CLIPBOARD_PATH" ipc call clipboard "$ACTION" 2>/dev/null || quickshell ipc call clipboard "$ACTION" 2>/dev/null || true
    exit 0
fi

# 2. Si no está en ejecución, iniciarlo en modo daemon
quickshell -d -n -p "$CLIPBOARD_PATH"

# Pequeña espera para inicializar socket IPC y ejecutar la acción
sleep 0.15
quickshell -p "$CLIPBOARD_PATH" ipc call clipboard "$ACTION" 2>/dev/null || quickshell ipc call clipboard "$ACTION" 2>/dev/null || true
