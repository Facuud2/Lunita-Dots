        )

    def build_ui(self):
        self.add_css_class("theme-selector")

        # Main vertical box
        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_content(main_vbox)

        # ── HeaderBar ──
        header = Adw.HeaderBar()
        header.set_show_end_title_buttons(True)

        # Title widget with moon icon
        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title_box.set_valign(Gtk.Align.CENTER)
        
        moon_label = Gtk.Label(label="🌙")
        moon_label.set_css_classes(["ts-moon-icon"])
        title_box.append(moon_label)

        title_text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_title = Gtk.Label(label="Theme Selector")
        main_title.set_css_classes(["title", "bold"])
        main_title.set_halign(Gtk.Align.START)
        
        sub_title = Gtk.Label(label="Lunita Dots Theme Manager")
        sub_title.set_css_classes(["subtitle", "dim-label"])
        sub_title.set_halign(Gtk.Align.START)
        
        title_text_box.append(main_title)
        title_text_box.append(sub_title)
        title_box.append(title_text_box)
        header.set_title_widget(title_box)

        # Refresh button in header
        refresh_btn = Gtk.Button(icon_name="view-refresh-symbolic")
        refresh_btn.set_tooltip_text("Recargar temas desde el disco")
        refresh_btn.connect("clicked", lambda _: self.load_themes())
        header.pack_end(refresh_btn)

        main_vbox.append(header)

        # ── Toast Overlay ──
        self.toast_overlay = Adw.ToastOverlay()
        main_vbox.append(self.toast_overlay)

        # ── Paned Content (Sidebar + Details) ──
        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.set_shrink_start_child(False)
        paned.set_shrink_end_child(False)
        paned.set_position(330)
        self.toast_overlay.set_child(paned)

        # ── Left: Sidebar ──
        sidebar_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        sidebar_box.set_css_classes(["ts-sidebar"])
        sidebar_box.set_size_request(310, -1)

        sidebar_title = Gtk.Label(label="Temas Disponibles")
        sidebar_title.set_halign(Gtk.Align.START)
        sidebar_title.set_css_classes(["ts-section-header"])
        sidebar_box.append(sidebar_title)

        # Themes scroll list
        scrolled_list = Gtk.ScrolledWindow()
        scrolled_list.set_vexpand(True)
        scrolled_list.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        self.theme_list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scrolled_list.set_child(self.theme_list_box)
        sidebar_box.append(scrolled_list)

        paned.set_start_child(sidebar_box)

        # ── Right: Theme Details Area ──
        self.details_scroll = Gtk.ScrolledWindow()
        self.details_scroll.set_vexpand(True)
        self.details_scroll.set_hexpand(True)
        self.details_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        self.details_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.details_box.set_css_classes(["ts-details-area"])
        self.details_scroll.set_child(self.details_box)

        paned.set_end_child(self.details_scroll)

    def load_themes(self):
        self.current_theme_id = get_current_theme_id()
        self.available_themes = scan_available_themes()

        # Clear existing list items
        while child := self.theme_list_box.get_first_child():
            self.theme_list_box.remove(child)

        self.card_widgets = {}

        if not self.available_themes:
            no_themes_label = Gtk.Label(label="No se encontraron temas en themes/")
            no_themes_label.set_css_classes(["dim-label"])
            self.theme_list_box.append(no_themes_label)
            return

        # Build card for each theme
        for theme in self.available_themes:
            card = self.create_theme_list_card(theme)
            self.card_widgets[theme.id] = card
            self.theme_list_box.append(card)

        # Auto-select current theme or first theme
        theme_to_select = next((t for t in self.available_themes if t.id == self.current_theme_id), self.available_themes[0])
        self.select_theme(theme_to_select)

    def create_theme_list_card(self, theme: ThemeInfo) -> Gtk.Widget:
        button = Gtk.Button()
        button.set_css_classes(["ts-theme-card"])
        if theme.id == self.current_theme_id:
            pass

        card_content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)

        # Row 1: Name and status badge
        row1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        
        name_label = Gtk.Label(label=theme.name)
        name_label.set_halign(Gtk.Align.START)
        name_label.set_hexpand(True)
        name_label.set_css_classes(["bold"])
        name_label.set_ellipsize(3) # PANGO_ELLIPSIZE_END
        row1.append(name_label)

        if theme.id == self.current_theme_id:
            active_badge = Gtk.Label(label="● ACTIVO")
            active_badge.set_css_classes(["ts-badge-active"])
            row1.append(active_badge)

        card_content.append(row1)

        # Row 2: ID and Version
        row2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        id_label = Gtk.Label(label=theme.id)
        id_label.set_css_classes(["dim-label"])
        id_label.set_halign(Gtk.Align.START)
        id_label.set_hexpand(True)
        row2.append(id_label)

        ver_badge = Gtk.Label(label=f"v{theme.version}")
        ver_badge.set_css_classes(["ts-badge-ver"])
        row2.append(ver_badge)

        card_content.append(row2)

        button.set_child(card_content)
        button.connect("clicked", lambda _: self.select_theme(theme))
        return button

    def select_theme(self, theme: ThemeInfo):
        self.selected_theme = theme

        # Update card selection classes
        for tid, card in self.card_widgets.items():
            if tid == theme.id:
                card.add_css_class("selected")
            else:
                card.remove_css_class("selected")

        self.render_theme_details(theme)

    def render_theme_details(self, theme: ThemeInfo):
        # Clear details
        while child := self.details_box.get_first_child():
            self.details_box.remove(child)

        is_current = (theme.id == self.current_theme_id)

        # ── Progress indicator if applying ──
        if self.is_applying:
            prog_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            prog_box.set_css_classes(["ts-progress-box"])

            spinner = Gtk.Spinner()
            spinner.start()
            prog_box.append(spinner)

            prog_lbl = Gtk.Label(label=f"Aplicando tema '{theme.name}'... Recargando entorno visual")
            prog_lbl.set_css_classes(["bold"])
            prog_box.append(prog_lbl)

            self.details_box.append(prog_box)

        # ── Hero Banner ──
        hero_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        hero_card.set_css_classes(["ts-hero-card"])

        hero_top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        
        hero_titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        hero_titles.set_hexpand(True)

        title_lbl = Gtk.Label(label=theme.name)
        title_lbl.set_halign(Gtk.Align.START)
        title_lbl.set_css_classes(["ts-hero-title"])
        hero_titles.append(title_lbl)

        author_text = f"por {theme.author}  ·  v{theme.version}  ·  ID: {theme.id}"
        sub_lbl = Gtk.Label(label=author_text)
        sub_lbl.set_halign(Gtk.Align.START)
        sub_lbl.set_css_classes(["ts-hero-sub"])
        hero_titles.append(sub_lbl)

        hero_top.append(hero_titles)

        # Status badge in hero
        if is_current:
            active_badge = Gtk.Label(label="● EN USO")
            active_badge.set_css_classes(["ts-badge-active"])
            active_badge.set_valign(Gtk.Align.START)
            hero_top.append(active_badge)

        hero_card.append(hero_top)

        # Action bar buttons
        action_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        if is_current:
            active_btn = Gtk.Button(label="✓ Tema Activo")
            active_btn.set_css_classes(["ts-btn-applied"])
            active_btn.set_sensitive(False)
            action_bar.append(active_btn)

            reapply_btn = Gtk.Button(label="🔄 Reaplicar")
            reapply_btn.set_css_classes(["ts-btn-secondary"])
            reapply_btn.set_tooltip_text("Volver a enlazar y recargar todos los componentes de este tema")
            reapply_btn.set_sensitive(not self.is_applying)
            reapply_btn.connect("clicked", lambda _: self.apply_theme_async(theme))
            action_bar.append(reapply_btn)
        else:
            apply_btn = Gtk.Button(label="✨ Aplicar Tema")
            apply_btn.set_css_classes(["ts-btn-apply"])
            apply_btn.set_sensitive(not self.is_applying)
            apply_btn.connect("clicked", lambda _: self.apply_theme_async(theme))
            action_bar.append(apply_btn)

        # Secondary: Open folder in file manager
        folder_btn = Gtk.Button(label="📁 Ver Carpeta")
        folder_btn.set_css_classes(["ts-btn-secondary"])
        folder_btn.set_tooltip_text(f"Abrir {theme.directory} en Dolphin")
        folder_btn.connect("clicked", lambda _: self.open_theme_folder(theme))
        action_bar.append(folder_btn)

        hero_card.append(action_bar)
        self.details_box.append(hero_card)

        # ── Description Card ──
        desc_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        desc_card.set_css_classes(["ts-section-card"])

        desc_header = Gtk.Label(label="Acerca del Tema")
        desc_header.set_halign(Gtk.Align.START)
        desc_header.set_css_classes(["ts-section-header"])
        desc_card.append(desc_header)

        desc_text = Gtk.Label(label=theme.description)
        desc_text.set_halign(Gtk.Align.START)
        desc_text.set_wrap(True)
        desc_text.set_css_classes(["dim-label"])
        desc_card.append(desc_text)

        self.details_box.append(desc_card)

        # ── Configured Components Card ──
        if theme.components:
            comp_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            comp_card.set_css_classes(["ts-section-card"])

            comp_header = Gtk.Label(label="Componentes del Sistema Configurados")
            comp_header.set_halign(Gtk.Align.START)
            comp_header.set_css_classes(["ts-section-header"])
            comp_card.append(comp_header)

            flow_box = Gtk.FlowBox()
            flow_box.set_selection_mode(Gtk.SelectionMode.NONE)
            flow_box.set_max_children_per_line(3)
            flow_box.set_min_children_per_line(2)
            flow_box.set_row_spacing(10)
            flow_box.set_column_spacing(10)

            for comp_k, comp_v in theme.components.items():
                chip = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                chip.set_css_classes(["ts-chip"])

                k_lbl = Gtk.Label(label=comp_k.replace("_", " "))
                k_lbl.set_halign(Gtk.Align.START)
                k_lbl.set_css_classes(["ts-chip-key"])
                chip.append(k_lbl)

                v_lbl = Gtk.Label(label=str(comp_v))
                v_lbl.set_halign(Gtk.Align.START)
                v_lbl.set_css_classes(["ts-chip-val"])
                chip.append(v_lbl)

                flow_box.append(chip)

            comp_card.append(flow_box)
            self.details_box.append(comp_card)

        # ── Features Card ──
        if theme.features:
            feat_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            feat_card.set_css_classes(["ts-section-card"])

            feat_header = Gtk.Label(label="Características & Estilo")
            feat_header.set_halign(Gtk.Align.START)
            feat_header.set_css_classes(["ts-section-header"])
            feat_card.append(feat_header)

            for feat in theme.features:
                item_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                item_box.set_css_classes(["ts-feature-item"])

                dot = Gtk.Label(label="✦")
                dot.set_css_classes(["bold"])
                dot.set_valign(Gtk.Align.START)
                item_box.append(dot)

                f_lbl = Gtk.Label(label=feat)
                f_lbl.set_halign(Gtk.Align.START)
                f_lbl.set_wrap(True)
                item_box.append(f_lbl)

                feat_card.append(item_box)

            self.details_box.append(feat_card)

    def open_theme_folder(self, theme: ThemeInfo):
        try:
            Gio.AppInfo.launch_default_for_uri(theme.directory.as_uri(), None)
        except Exception:
            subprocess.Popen(["dolphin", str(theme.directory)])

    def apply_theme_async(self, theme: ThemeInfo):
        if self.is_applying:
            return

        self.is_applying = True
        self.render_theme_details(theme)

        def worker():
            cmd = ["lunita-theme", "apply", theme.id]
            error_msg = None
            try:
                proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                if proc.returncode != 0:
                    error_msg = proc.stderr.strip() or f"Código de salida: {proc.returncode}"
            except Exception as e:
                error_msg = str(e)

            GLib.idle_add(self.on_apply_finished, theme, error_msg)

        threading.Thread(target=worker, daemon=True).start()

    def on_apply_finished(self, theme: ThemeInfo, error_msg: str | None):
        self.is_applying = False
        if error_msg:
            toast = Adw.Toast(title=f"Error al aplicar tema: {error_msg}")
            self.toast_overlay.add_toast(toast)
        else:
            self.current_theme_id = theme.id
            toast = Adw.Toast(title=f"¡Tema '{theme.name}' aplicado exitosamente!")
            self.toast_overlay.add_toast(toast)

        self.load_themes()
        return False

class ThemeSelectorApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="io.lunita.ThemeSelector",
            flags=Gio.ApplicationFlags.DEFAULT_FLAGS
        )

    def do_activate(self):
        win = self.props.active_window
        if not win:
            # Force Dark style
            style_mgr = Adw.StyleManager.get_default()
            style_mgr.set_color_scheme(Adw.ColorScheme.FORCE_DARK)
            win = ThemeSelectorWindow(self)
        win.present()

def main():
    app = ThemeSelectorApp()
    return app.run(sys.argv)

if __name__ == "__main__":
    sys.exit(main())
