#!/usr/bin/env python3
# ==============================================================================
# 🌙 LUNITA THEME SELECTOR (GUI)
# Selector gráfico de temas para Lunita-Dots
# ==============================================================================

import os
import sys
import json
import subprocess
import threading
from pathlib import Path

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio, Gdk

# ── Detección de rutas Lunita-Dots ───────────────────────────────────────────
SCRIPT_DIR = Path(__file__).resolve().parent
DOTS_DIR = SCRIPT_DIR.parent
THEMES_DIR = DOTS_DIR / "themes"
STATE_FILE = DOTS_DIR / ".lunita-theme"
USER_STATE_DIR = Path.home() / ".config/lunita"
USER_STATE_FILE = USER_STATE_DIR / "current_theme"
AGS_COLORS_FILE = Path.home() / ".config/ags/colors.scss"

def get_current_theme_id() -> str:
    if STATE_FILE.exists():
        try:
            return STATE_FILE.read_text().strip()
        except Exception:
            pass
    if USER_STATE_FILE.exists():
        try:
            return USER_STATE_FILE.read_text().strip()
        except Exception:
            pass
    return "lunita-default"

def load_theme_colors():
    colors = {
        "primary": "#007aff",
        "on_primary": "#ffffff",
        "primary_container": "#007aff33",
        "surface": "#161618",
        "surface_container": "#222224",
        "surface_container_high": "#2c2c2e",
        "surface_container_highest": "#3a3a3c",
        "on_surface": "#f5f5f7",
        "on_surface_variant": "#8e8e93",
        "outline": "#8e8e93",
        "outline_variant": "#3a3a3c",
    }
    
    # Try reading from ags colors.scss if present
    if AGS_COLORS_FILE.exists():
        try:
            for line in AGS_COLORS_FILE.read_text().splitlines():
                line = line.strip()
                if line.startswith("$") and ":" in line:
                    key, val = line.split(":", 1)
                    key = key.lstrip("$").strip()
                    val = val.rstrip(";").strip()
                    if key in colors:
                        colors[key] = val
        except Exception:
            pass
            
    return colors

class ThemeInfo:
    def __init__(self, theme_id: str, directory: Path):
        self.id = theme_id
        self.directory = directory
        self.name = theme_id.capitalize()
        self.version = "1.0.0"
        self.author = "Desconocido"
        self.description = "Sin descripción disponible."
        self.components = {}
        self.features = []

        json_path = directory / "theme.json"
        if json_path.exists():
            try:
                data = json.loads(json_path.read_text())
                self.id = data.get("id", self.id)
                self.name = data.get("name", self.name)
                self.version = data.get("version", self.version)
                self.author = data.get("author", self.author)
                self.description = data.get("description", self.description)
                self.components = data.get("components", {})
                self.features = data.get("features", [])
            except Exception as e:
                print(f"[ThemeSelector] Error parsing {json_path}: {e}", file=sys.stderr)

def scan_available_themes():
    themes = []
    if THEMES_DIR.exists() and THEMES_DIR.is_dir():
        for item in sorted(THEMES_DIR.iterdir()):
            if item.is_dir():
                themes.append(ThemeInfo(item.name, item))
    return themes

class ThemeSelectorWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Theme Selector")
        self.set_default_size(920, 640)
        self.set_title("Theme Selector")

        self.available_themes = []
        self.current_theme_id = get_current_theme_id()
        self.selected_theme = None
        self.is_applying = False

        self.setup_css()
        self.build_ui()
        self.load_themes()

