local M = {}

function M.setup()
    -- See https://wiki.hypr.land/Configuring/Basics/Monitors/
    hl.monitor({
        output   = "DP-1",
        mode     = "1920x1080@240",
        position = "0x0",
        scale    = "1",
    })

    hl.monitor({
        output   = "HDMI-A-1",
        mode     = "1920x1080@60",
        position = "-1920x460",
        scale    = "1",
    })

    hl.monitor({
        output   = "DP-3",
        mode     = "1920x1080@60",
        position = "-620x-1080",
        scale    = "1",
    })
end

return M
