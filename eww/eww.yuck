;; ====================================================================
;; EWW MUSIC PLAYER WIDGET (DYNAMIC MATUGEN THEME)
;; ====================================================================

(deflisten cava_output :initial "▁▁▁▁▁▁▁▁▁▁▁▁▁▁"
  "scripts/cava.sh")

(deflisten media :initial '{"status":"Stopped","player":"","title":"No Music Playing","artist":"","cover":"/home/facuud2/.config/eww/assets/default_cover.png","has_media":false}'
  "scripts/media.py")

(deflisten wallpaper_theme :initial ""
  "scripts/watch_wallpaper.sh")

(defwidget music_player_widget []
  (box :class "music-player-window"
       :orientation "vertical"
       :space-evenly false
       :tooltip "${wallpaper_theme}"

    ;; Top section: Cover Art + Info (Stream badge, title, artist)
    (box :class "header-section"
         :orientation "horizontal"
         :space-evenly false
         :spacing 16
         :valign "start"

      ;; Cover art (scaled cleanly with ffmpeg)
      (box :class "cover-art-box"
           :valign "center"
           :halign "center"
        (image :class "cover-art-img"
               :path {media.cover}
               :image-width 96
               :image-height 96))

      ;; Info column: Stream Badge + Song Title + Artist
      (box :class "meta-box"
           :orientation "vertical"
           :space-evenly false
           :spacing 6
           :valign "center"

        ;; Stream source pill badge
        (box :class "badge-row"
             :space-evenly false
          (label :class "stream-badge"
                 :visible {media.has_media && media.player != ""}
                 :text {media.player})
          (label :class "stream-badge offline"
                 :visible {!media.has_media || media.player == ""}
                 :text "Idle"))

        ;; Song Title
        (label :class "track-title"
               :limit-width 18
               :text {media.has_media ? media.title : "No Music Playing"}
               :tooltip {media.has_media ? media.title : ""})

        ;; Artist name
        (label :class "track-artist"
               :limit-width 20
               :visible {media.has_media && media.artist != ""}
               :text {media.artist})))

    ;; Middle section: Cava audio visualizer (expanded vertically to center)
    (box :class "cava-container"
         :halign "center"
         :valign "center"
         :vexpand true
      (label :class "cava-bar"
             :text cava_output))

    ;; Bottom section: Playback controls
    (box :class "controls-container"
         :orientation "horizontal"
         :space-evenly false
         :spacing 20
         :halign "center"
         :valign "end"

      ;; Previous track
      (button :class "ctrl-btn"
              :onclick "playerctl previous"
              :tooltip "Previous track"
              "|‹")

      ;; Play / Pause toggle
      (button :class "ctrl-btn play-btn"
              :onclick "playerctl play-pause"
              :tooltip "Play / Pause"
              {media.status == "Playing" ? "⏸" : "▶"})

      ;; Next track
      (button :class "ctrl-btn"
              :onclick "playerctl next"
              :tooltip "Next track"
              "›|"))))

;; Window for Monitor 0 (DP-1)
(defwindow music_player_0
  :monitor 0
  :geometry (geometry :x "24px"
                      :y "24px"
                      :anchor "top right")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (music_player_widget))

;; Window for Monitor 1 (HDMI-A-1)
(defwindow music_player_1
  :monitor 1
  :geometry (geometry :x "24px"
                      :y "24px"
                      :anchor "top right")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (music_player_widget))
