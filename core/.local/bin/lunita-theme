#!/usr/bin/env bash
# ==============================================================================
# 🌙 LUNITA THEME MANAGER CLI (Powered by GNU Stow)
# Gestor central de temas y dotfiles para Lunita-Dots
# ==============================================================================

set -e

# Detectar directorio raíz canónico del repositorio Lunita-Dots
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

get_dots_dir() {
    local d="$1"
    while [ "$d" != "/" ] && [ -n "$d" ]; do
        if [ -d "$d/themes" ] && [ -d "$d/core" ]; then
            echo "$d"
            return 0
        fi
        d="$(dirname "$d")"
    done
    return 1
}
DOTS_DIR="$(get_dots_dir "$SCRIPT_DIR" 2>/dev/null || (cd "$SCRIPT_DIR/../../.." && pwd))"
THEMES_DIR="$DOTS_DIR/themes"
STATE_FILE="$DOTS_DIR/.lunita-theme"
USER_STATE_DIR="$HOME/.config/lunita"
USER_STATE_FILE="$USER_STATE_DIR/current_theme"

# Colores y estilo
BOLD="\033[1m"
GREEN="\033[32m"
BLUE="\033[34m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
MAGENTA="\033[35m"
RESET="\033[0m"

info() { echo -e "${CYAN}ℹ${RESET} $1"; }
success() { echo -e "${GREEN}✓${RESET} $1"; }
warn() { echo -e "${YELLOW}⚠${RESET} $1"; }
error() { echo -e "${RED}✗${RESET} $1" >&2; }

# Verificar que GNU Stow esté instalado
check_stow() {
    if ! command -v stow >/dev/null 2>&1; then
        error "GNU Stow no está instalado en el sistema."
        echo "Por favor instálalo ejecutando: sudo pacman -S stow (o yay -S stow)"
        exit 1
    fi
}

# Obtener nombre del tema activo actual
get_current_theme() {
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE" | tr -d '[:space:]'
    elif [ -f "$USER_STATE_FILE" ]; then
        cat "$USER_STATE_FILE" | tr -d '[:space:]'
    else
        echo "lunita-default"
    fi
}

# Limpiar enlaces manuales/antiguos y resolver colisiones antes de ejecutar Stow
clean_legacy_links() {
    local target_pkg="${1:-}"
    info "Verificando y resolviendo posibles colisiones previas de Stow..."
    python3 -c "
import os, sys, re

home = os.path.expanduser('~')
dots_prefix = '$DOTS_DIR'
target_pkg = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] else ''

# 1. Si se provee un paquete específico (e.g. core o un tema), resolver conflictos directos
if target_pkg and os.path.isdir(target_pkg):
    ignore_patterns = [re.compile(r'^\.stow-local-ignore$')]
    ignore_file = os.path.join(target_pkg, '.stow-local-ignore')
    if os.path.exists(ignore_file):
        with open(ignore_file, 'r', errors='ignore') as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#'):
                    try:
                        ignore_patterns.append(re.compile(line))
                    except Exception:
                        pass

    def is_ignored(rel_p):
        parts = rel_p.split(os.sep)
        for pat in ignore_patterns:
            if pat.search(rel_p) or pat.search(parts[0]):
                return True
        return False

    for root, dirs, files in os.walk(target_pkg):
        rel_root = os.path.relpath(root, target_pkg)
        if rel_root != '.' and is_ignored(rel_root):
            continue

        if rel_root != '.':
            target_dir = os.path.join(home, rel_root)
            if os.path.islink(target_dir):
                try:
                    real_dir = os.path.realpath(target_dir)
                    if real_dir != os.path.realpath(root) and (real_dir.startswith(dots_prefix) or not os.path.exists(target_dir)):
                        os.unlink(target_dir)
                except Exception:
                    pass

        for f in files:
            rel_file = os.path.normpath(os.path.join(rel_root, f)) if rel_root != '.' else f
            if is_ignored(rel_file):
                continue
            src_file = os.path.join(target_pkg, rel_file)
            target_file = os.path.join(home, rel_file)
            if os.path.lexists(target_file):
                try:
                    real_target = os.path.realpath(target_file)
                    if os.path.islink(target_file):
                        if real_target != os.path.realpath(src_file):
                            os.unlink(target_file)
                    else:
                        # Si no es un enlace, y NO apunta a la carpeta del repositorio (ej. archivo regular generado por Matugen)
                        if not real_target.startswith(dots_prefix):
                            os.remove(target_file)
                except Exception:
                    pass

# 2. Limpieza general de enlaces rotos de Lunita-Dots en directorios comunes
scan_dirs = [
    os.path.join(home, '.config'),
    os.path.join(home, '.local', 'bin'),
    os.path.join(home, '.local', 'share'),
    os.path.join(home, '.icons'),
    os.path.join(home, '.oh-my-zsh', 'custom')
]
for base in scan_dirs:
    if not os.path.exists(base): continue
    for root, dirs, files in os.walk(base, topdown=False):
        for name in files + dirs:
            p = os.path.join(root, name)
            if os.path.islink(p):
                try:
                    target = os.path.realpath(p)
                    raw_target = os.readlink(p)
                    if (raw_target.startswith(dots_prefix) or target.startswith(dots_prefix)) and not os.path.exists(p):
                        os.unlink(p)
                except Exception:
                    pass
" "$target_pkg" 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# Comando: LIST
# ------------------------------------------------------------------------------
cmd_list() {
    local current
    current="$(get_current_theme)"
    
    echo -e "${BOLD}${MAGENTA}🌙 Lunita-Dots — Temas Disponibles${RESET}"
    echo "=================================================="

    if [ ! -d "$THEMES_DIR" ]; then
        error "No se encontró el directorio de temas en $THEMES_DIR"
        exit 1
    fi

    for theme_path in "$THEMES_DIR"/*; do
        if [ -d "$theme_path" ] && [ ! -L "$theme_path" ]; then
            local theme_id
            theme_id="$(basename "$theme_path")"
            local theme_json="$theme_path/theme.json"
            local theme_name="$theme_id"
            local theme_desc="Sin descripción disponible"
            local theme_author="Desconocido"
            local theme_ver="1.0"

            if [ -f "$theme_json" ] && command -v jq &>/dev/null; then
                theme_name="$(jq -r '.name // "'"$theme_id"'"' "$theme_json")"
                theme_desc="$(jq -r '.description // "Sin descripción"' "$theme_json")"
                theme_author="$(jq -r '.author // "Desconocido"' "$theme_json")"
                theme_ver="$(jq -r '.version // "1.0"' "$theme_json")"
            fi

            if [ "$theme_id" = "$current" ]; then
                echo -e "${GREEN}${BOLD}● $theme_name${RESET} (${CYAN}$theme_id${RESET}) ${GREEN}${BOLD}[ACTIVO]${RESET}"
            else
                echo -e "○ ${BOLD}$theme_name${RESET} (${CYAN}$theme_id${RESET})"
            fi
            echo -e "  ${YELLOW}Versión:${RESET} $theme_ver | ${YELLOW}Autor:${RESET} $theme_author"
            echo -e "  ${BOLD}Descripción:${RESET} $theme_desc"
            echo ""
        fi
    done
}

# ------------------------------------------------------------------------------
# Generación Dinámica de Marcadores de Usuario (XDG)
# ------------------------------------------------------------------------------
generate_user_bookmarks() {
    local target_dir="$1"

    python3 - "$target_dir" <<'EOF'
import os
import sys
import subprocess
from pathlib import Path

target_dir = Path(sys.argv[1]) if len(sys.argv) > 1 else None
if not target_dir or not target_dir.is_dir():
    sys.exit(0)

def get_xdg_dir(name, fallback_candidates):
    try:
        out = subprocess.check_output(["xdg-user-dir", name], stderr=subprocess.DEVNULL, text=True).strip()
        if out and Path(out).is_dir():
            return Path(out)
    except Exception:
        pass

    user_dirs_file = Path.home() / ".config/user-dirs.dirs"
    if user_dirs_file.is_file():
        try:
            for line in user_dirs_file.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if line.startswith(f"XDG_{name}_DIR="):
                    val = line.split("=", 1)[1].strip("\"'")
                    val = val.replace("$HOME", str(Path.home()))
                    p = Path(val)
                    if p.is_dir():
                        return p
        except Exception:
            pass

    for fb in fallback_candidates:
        candidate = Path.home() / fb
        if candidate.is_dir():
            return candidate

    return Path.home() / fallback_candidates[0]

home = Path.home()
user = os.environ.get("USER") or home.name

substitutions = {
    "{{HOME}}": str(home),
    "{{USER}}": user,
    "{{XDG_DOCUMENTS_DIR}}": str(get_xdg_dir("DOCUMENTS", ["Documentos", "Documents"])),
    "{{XDG_DOWNLOAD_DIR}}": str(get_xdg_dir("DOWNLOAD", ["Downloads", "Descargas"])),
    "{{XDG_PICTURES_DIR}}": str(get_xdg_dir("PICTURES", ["Imagenes", "Pictures", "Imágenes"])),
    "{{XDG_VIDEOS_DIR}}": str(get_xdg_dir("VIDEOS", ["Videos", "Vídeos"])),
    "{{XDG_MUSIC_DIR}}": str(get_xdg_dir("MUSIC", ["Musica", "Music", "Música"])),
    "{{XDG_DESKTOP_DIR}}": str(get_xdg_dir("DESKTOP", ["Desktop", "Escritorio"])),
}

# Procesar plantillas en el tema destino
for tmpl in target_dir.glob("**/*.template"):
    dest = tmpl.with_suffix("")
    try:
        content = tmpl.read_text(encoding="utf-8")
        for placeholder, value in substitutions.items():
            content = content.replace(placeholder, value)
        dest.write_text(content, encoding="utf-8")
    except Exception as e:
        sys.stderr.write(f"Error procesando plantilla {tmpl}: {e}\n")
EOF
}

# ------------------------------------------------------------------------------
# Comando: CURRENT
# ------------------------------------------------------------------------------
cmd_current() {
    local current
    current="$(get_current_theme)"
    local theme_dir="$THEMES_DIR/$current"
    local theme_json="$theme_dir/theme.json"

    echo -e "${BOLD}${MAGENTA}🌙 Tema Activo:${RESET} ${GREEN}${BOLD}$current${RESET}"
    echo "--------------------------------------------------"

    if [ -f "$theme_json" ] && command -v jq &>/dev/null; then
        local name author desc
        name="$(jq -r '.name // "'"$current"'"' "$theme_json")"
        author="$(jq -r '.author // "Desconocido"' "$theme_json")"
        desc="$(jq -r '.description // "Sin descripción"' "$theme_json")"
        
        echo -e "${BOLD}Nombre:${RESET} $name"
        echo -e "${BOLD}Autor:${RESET}  $author"
        echo -e "${BOLD}Detalles:${RESET} $desc"
        echo ""
        echo -e "${BOLD}Componentes configurados:${RESET}"
        jq -r '.components | to_entries[] | "  - \(.key): \(.value)"' "$theme_json" 2>/dev/null || true
    else
        echo "Ruta: $theme_dir"
    fi
}

# ------------------------------------------------------------------------------
# Comando: STOW
# ------------------------------------------------------------------------------
cmd_stow() {
    check_stow
    local target="${1:-all}"
    local current
    current="$(get_current_theme)"

    mkdir -p "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/share" "$HOME/.icons" "$USER_STATE_DIR"

    case "$target" in
        core)
            info "Vinculando paquete 'core' con GNU Stow..."
            clean_legacy_links "$DOTS_DIR/core"
            stow -d "$DOTS_DIR" -t "$HOME" -S core
            success "Paquete core vinculado exitosamente."
            ;;
        theme)
            info "Vinculando tema '$current' con GNU Stow..."
            clean_legacy_links "$THEMES_DIR/$current"
            generate_user_bookmarks "$THEMES_DIR/$current"
            stow -d "$THEMES_DIR" -t "$HOME" -S "$current"
            success "Tema '$current' vinculado exitosamente."
            ;;
        all|"")
            info "Vinculando core y tema actual ($current) con GNU Stow..."
            clean_legacy_links "$DOTS_DIR/core"
            stow -d "$DOTS_DIR" -t "$HOME" -S core
            clean_legacy_links "$THEMES_DIR/$current"
            generate_user_bookmarks "$THEMES_DIR/$current"
            stow -d "$THEMES_DIR" -t "$HOME" -S "$current"
            success "Todos los paquetes vinculados exitosamente con GNU Stow."
            ;;
        *)
            if [ -d "$THEMES_DIR/$target" ]; then
                info "Vinculando tema '$target' con GNU Stow..."
                clean_legacy_links "$THEMES_DIR/$target"
                generate_user_bookmarks "$THEMES_DIR/$target"
                stow -d "$THEMES_DIR" -t "$HOME" -S "$target"
                success "Tema '$target' vinculado."
            else
                error "Paquete o tema desconocido: $target"
                exit 1
            fi
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Comando: UNSTOW
# ------------------------------------------------------------------------------
cmd_unstow() {
    check_stow
    local target="${1:-theme}"
    local current
    current="$(get_current_theme)"

    case "$target" in
        core)
            info "Desvinculando paquete core..."
            stow -d "$DOTS_DIR" -t "$HOME" -D core 2>/dev/null || true
            success "Paquete core desvinculado."
            ;;
        theme)
            info "Desvinculando tema actual ($current)..."
            stow -d "$THEMES_DIR" -t "$HOME" -D "$current" 2>/dev/null || true
            success "Tema '$current' desvinculado."
            ;;
        all)
            info "Desvinculando todos los dotfiles de Lunita-Dots..."
            stow -d "$THEMES_DIR" -t "$HOME" -D "$current" 2>/dev/null || true
            stow -d "$DOTS_DIR" -t "$HOME" -D core 2>/dev/null || true
            success "Todos los paquetes desvinculados."
            ;;
        *)
            if [ -d "$THEMES_DIR/$target" ]; then
                info "Desvinculando tema '$target'..."
                stow -d "$THEMES_DIR" -t "$HOME" -D "$target" 2>/dev/null || true
                success "Tema '$target' desvinculado."
            else
                error "Tema desconocido: $target"
                exit 1
            fi
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Comando: RESTOW
# ------------------------------------------------------------------------------
cmd_restow() {
    check_stow
    local current
    current="$(get_current_theme)"
    info "Reiniciando enlaces de GNU Stow (core + $current)..."
    clean_legacy_links "$DOTS_DIR/core"
    stow -d "$DOTS_DIR" -t "$HOME" -R core 2>/dev/null || stow -d "$DOTS_DIR" -t "$HOME" -S core
    clean_legacy_links "$THEMES_DIR/$current"
    stow -d "$THEMES_DIR" -t "$HOME" -R "$current" 2>/dev/null || stow -d "$THEMES_DIR" -t "$HOME" -S "$current"
    success "Dotfiles revinculados correctamente con GNU Stow."
}

# ------------------------------------------------------------------------------
# Comando: APPLY / SET
# ------------------------------------------------------------------------------
cmd_apply() {
    check_stow
    local target="$1"

    if [ -z "$target" ]; then
        error "Debes especificar el identificador del tema. Ejemplo: lunita-theme apply lunita-default"
        exit 1
    fi

    local target_dir="$THEMES_DIR/$target"
    if [ ! -d "$target_dir" ]; then
        error "El tema '$target' no existe en $THEMES_DIR"
        echo "Usa 'lunita-theme list' para ver los temas disponibles."
        exit 1
    fi

    local current
    current="$(get_current_theme 2>/dev/null || true)"

    info "Aplicando tema: ${BOLD}$target${RESET} usando GNU Stow..."

    # 1. Asegurar directorios base en $HOME
    mkdir -p "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/share" "$HOME/.icons" "$USER_STATE_DIR"

    # 2. Desvincular tema anterior con Stow (si existía)
    if [ -n "$current" ] && [ -d "$THEMES_DIR/$current" ] && [ "$current" != "$target" ]; then
        info "Desvinculando tema anterior (${CYAN}$current${RESET}) con GNU Stow..."
        stow -d "$THEMES_DIR" -t "$HOME" -D "$current" 2>/dev/null || true
    fi

    # 3. Vincular paquete core (siempre activo e independiente del tema)
    clean_legacy_links "$DOTS_DIR/core"
    stow -d "$DOTS_DIR" -t "$HOME" -S core

    # 4. Vincular el nuevo tema
    clean_legacy_links "$target_dir"
    generate_user_bookmarks "$target_dir"
    stow -d "$THEMES_DIR" -t "$HOME" -S "$target"
    success "Archivos y configuraciones del tema enlazados con GNU Stow."

    # 4.1. Normalizar dinámicamente rutas de usuario en archivos de configuración
    for conf_file in "$HOME/.config/qt6ct/qt6ct.conf" "$HOME/.config/gtk-3.0/bookmarks" "$HOME/.local/share/user-places.xbel"; do
        if [ -e "$conf_file" ]; then
            sed --follow-symlinks -i "s|/home/[a-zA-Z0-9._-]\+|$HOME|g" "$conf_file" 2>/dev/null || true
        fi
    done

    # Recargar daemon systemd de usuario si hay servicios definidos
    if [ -d "$target_dir/.config/systemd/user" ] || [ -d "$target_dir/systemd/user" ]; then
        systemctl --user daemon-reload 2>/dev/null || true
    fi

    # 5. Guardar estado
    echo "$target" > "$STATE_FILE"
    echo "$target" > "$USER_STATE_FILE"

    # 5.1 Sincronizar directorio de wallpapers del tema y aplicar fondo por defecto
    if [ -d "$target_dir/wallpaper" ]; then
        mkdir -p "$USER_STATE_DIR"
        ln -sfn "$target_dir/wallpaper" "$USER_STATE_DIR/wallpaper"
        info "Directorio de wallpapers sincronizado para '$target'."

        local default_wall
        default_wall="$(find -L "$target_dir/wallpaper" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" \) 2>/dev/null | sort | head -n 1)"
        if [ -n "$default_wall" ]; then
            if [ -x "$HOME/.config/quickshell/hyprquickpaper/commands.sh" ]; then
                "$HOME/.config/quickshell/hyprquickpaper/commands.sh" "$default_wall" >/dev/null 2>&1 &
            elif [ -x "$DOTS_DIR/core/.config/quickshell/hyprquickpaper/commands.sh" ]; then
                "$DOTS_DIR/core/.config/quickshell/hyprquickpaper/commands.sh" "$default_wall" >/dev/null 2>&1 &
            elif [ -x "$target_dir/.config/quickshell/hyprquickpaper/commands.sh" ]; then
                "$target_dir/.config/quickshell/hyprquickpaper/commands.sh" "$default_wall" >/dev/null 2>&1 &
            elif command -v awww &>/dev/null; then
                awww img "$default_wall" --transition-type grow --transition-duration 1.2 2>/dev/null || true
            fi
        fi
    fi

    # 6. Sincronización y recarga/detención de componentes en ejecución
    info "Sincronizando componentes visuales..."

    # Gestión de Eww
    if [ -d "$target_dir/.config/eww" ] || [ -d "$target_dir/eww" ]; then
        if pgrep -x eww > /dev/null; then
            eww reload 2>/dev/null || true
            success "Eww recargado."
        elif [ -x "$HOME/.config/eww/scripts/launch.sh" ]; then
            "$HOME/.config/eww/scripts/launch.sh" &
            success "Eww iniciado."
        fi
    else
        if pgrep -x eww > /dev/null; then
            eww kill 2>/dev/null || true
            pkill -x eww 2>/dev/null || true
            info "Eww cerrado (no configurado en '$target')."
        fi
    fi

    # Obtener configuración de cursor, tema e iconos del tema actual
    local cursor_theme="Bibata-Modern-Ice"
    local cursor_size="40"
    local color_scheme="prefer-dark"
    local icon_theme="WhiteSur"

    local gtk3_ini="$target_dir/.config/gtk-3.0/settings.ini"
    [ ! -f "$gtk3_ini" ] && gtk3_ini="$target_dir/gtk-3.0/settings.ini"

    if [ -f "$gtk3_ini" ]; then
        local ct="$(grep '^gtk-cursor-theme-name=' "$gtk3_ini" | cut -d= -f2 | tr -d ' ' || true)"
        local cs="$(grep '^gtk-cursor-theme-size=' "$gtk3_ini" | cut -d= -f2 | tr -d ' ' || true)"
        [ -n "$ct" ] && cursor_theme="$ct"
        [ -n "$cs" ] && cursor_size="$cs"

        if grep -q 'gtk-application-prefer-dark-theme=0' "$gtk3_ini"; then
            color_scheme="prefer-light"
        fi
        icon_theme="$(grep '^gtk-icon-theme-name=' "$gtk3_ini" | cut -d= -f2 | tr -d ' ' || echo 'WhiteSur')"
    fi

    # Recargar Hyprland y aplicar cursor
    if pgrep -x Hyprland > /dev/null; then
        hyprctl setcursor "$cursor_theme" "$cursor_size" >/dev/null 2>&1 || true
        hyprctl reload >/dev/null 2>&1 || true
        success "Hyprland recargado con cursor '$cursor_theme' ($cursor_size px)."
    fi

    # Sincronizar tema de cursor, GTK e iconos en GSettings / dconf
    if command -v gsettings &>/dev/null; then
        gsettings set org.gnome.desktop.interface cursor-theme "$cursor_theme" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface cursor-size "$cursor_size" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" 2>/dev/null || true
    fi

    # Sincronizar tokens de diseño en GTK, Qt y Quickshell
    if command -v lunita-palette-sync >/dev/null 2>&1; then
        lunita-palette-sync sync 2>/dev/null || true
    elif [ -x "$DOTS_DIR/core/.local/bin/lunita-palette-sync" ]; then
        "$DOTS_DIR/core/.local/bin/lunita-palette-sync" sync 2>/dev/null || true
    fi

    # Reiniciar portal GTK para aplicar estilos CSS actualizados
    if systemctl --user is-active --quiet xdg-desktop-portal-gtk 2>/dev/null; then
        systemctl --user restart xdg-desktop-portal-gtk 2>/dev/null || true
    fi

    # Recargar Kitty
    if pgrep -x kitty > /dev/null; then
        kill -SIGUSR1 $(pgrep -x kitty) 2>/dev/null || true
        success "Terminales Kitty recargadas."
    fi

    # Gestión de AGS (solo si el tema no usa barra de Quickshell)
    local uses_qs_bar=false
    if [ -d "$target_dir/.config/quickshell/bar" ] || [ -d "$target_dir/quickshell/bar" ]; then
        uses_qs_bar=true
    fi

    if [ "$uses_qs_bar" = false ] && ([ -d "$target_dir/.config/ags" ] || [ -d "$target_dir/ags" ]); then
        if pgrep -x ags > /dev/null; then
            ags quit 2>/dev/null || true
            sleep 0.3
        fi
        hyprctl dispatch 'hl.dsp.exec_cmd("env PATH=$HOME/.local/bin:$PATH ags run")' >/dev/null 2>&1 || true
        success "AGS iniciado/reiniciado con los nuevos componentes."
    else
        if pgrep -x ags > /dev/null; then
            ags quit 2>/dev/null || true
            sleep 0.2
            pkill -x ags 2>/dev/null || true
            info "AGS detenido (tema migrado o sin AGS)."
        fi
    fi

    # Gestión de Quickshell (orquestación unificada y autoritaria según theme.json)
    if command -v lunita-quickshell >/dev/null 2>&1; then
        lunita-quickshell restart 2>/dev/null || true
    elif [ -x "$DOTS_DIR/core/.local/bin/lunita-quickshell" ]; then
        "$DOTS_DIR/core/.local/bin/lunita-quickshell" restart 2>/dev/null || true
    fi


    # Gestión de Tokri (Canasta macOS)
    if command -v lunita-tokri >/dev/null 2>&1; then
        lunita-tokri reload-theme >/dev/null 2>&1 || true
    fi

    echo ""
    success "${BOLD}¡Tema '$target' aplicado exitosamente con GNU Stow!${RESET}"
}

# ------------------------------------------------------------------------------
# Comando: CREATE (Scaffold para Tema nuevo en formato Stow)
# ------------------------------------------------------------------------------
cmd_create() {
    local new_theme="$1"

    if [ -z "$new_theme" ]; then
        error "Debes especificar el nombre para el nuevo tema. Ejemplo: lunita-theme create tema-2"
        exit 1
    fi

    local dest="$THEMES_DIR/$new_theme"
    if [ -d "$dest" ]; then
        error "El tema '$new_theme' ya existe en $dest"
        exit 1
    fi

    info "Creando estructura base para nuevo tema '${BOLD}$new_theme${RESET}' compatible con GNU Stow..."
    mkdir -p "$dest/.config"/{ags,eww,kitty,matugen/templates,matugen/hooks,wlogout,quickshell}
    mkdir -p "$dest/.local/share"
    mkdir -p "$dest/.icons"
    mkdir -p "$dest/wallpaper"

    cat << 'EOF' > "$dest/.stow-local-ignore"
^theme\.json$
^README\.md$
^assets$
^wallpaper$
^tokri$
^zsh$
.*\.bak.*
.*\.orig.*
EOF

    # Crear theme.json
    cat << JSON > "$dest/theme.json"
{
  "id": "$new_theme",
  "name": "${new_theme^}",
  "version": "1.0.0",
  "author": "$(whoami)",
  "description": "Nuevo tema personalizado para Lunita-Dots.",
  "components": {
    "bar": "custom",
    "launcher": "custom",
    "widgets": "custom",
    "color_engine": "matugen"
  },
  "features": [
    "Diseño personalizado"
  ]
}
JSON

    # Crear README.md
    cat << MD > "$dest/README.md"
# 🎨 Tema: ${new_theme^}

Tema personalizado creado a partir de la arquitectura modular y paquetes GNU Stow de Lunita-Dots.

## Componentes
- **Configuraciones**: Ubicadas en \`.config/\`, \`.local/share/\` y \`.icons/\`.
- **Descriptor**: \`theme.json\`.
MD

    success "Tema creado en: $dest"
    echo ""
    echo -e "Puedes empezar a personalizar tu nuevo tema en: ${CYAN}$dest${RESET}"
    echo -e "Para activarlo una vez configurado, ejecuta: ${GREEN}lunita-theme apply $new_theme${RESET}"
}

# ------------------------------------------------------------------------------
# Comando: GUI (Lanzar selector gráfico)
# ------------------------------------------------------------------------------
cmd_gui() {
    if command -v lunita-theme-selector &>/dev/null; then
        lunita-theme-selector &
    elif [ -f "$DOTS_DIR/core/.local/bin/lunita-theme-selector" ]; then
        "$DOTS_DIR/core/.local/bin/lunita-theme-selector" &
    else
        error "No se encontró el ejecutable lunita-theme-selector"
        exit 1
    fi
}

# ------------------------------------------------------------------------------
# Menú de Ayuda
# ------------------------------------------------------------------------------
cmd_help() {
    echo -e "${BOLD}${MAGENTA}🌙 Lunita Theme Manager${RESET} — Control de Temas y GNU Stow para Lunita-Dots"
    echo ""
    echo -e "${BOLD}Uso:${RESET} lunita-theme [COMANDO] [ARGUMENTOS]"
    echo ""
    echo -e "${BOLD}Comandos:${RESET}"
    echo -e "  ${CYAN}gui${RESET}                       Abre el selector gráfico de temas (Theme Selector)."
    echo -e "  ${CYAN}list, ls${RESET}                  Lista todos los temas disponibles e indica el activo."
    echo -e "  ${CYAN}current${RESET}                   Muestra información y componentes del tema actual."
    echo -e "  ${CYAN}apply, set <tema>${RESET}         Aplica el tema indicado con Stow y recarga el entorno."
    echo -e "  ${CYAN}stow [core|theme|all]${RESET}     Vincula paquetes mediante GNU Stow."
    echo -e "  ${CYAN}unstow [core|theme|all]${RESET}   Desvincula paquetes de GNU Stow."
    echo -e "  ${CYAN}restow${RESET}                    Reconstruye los enlaces simbólicos de Stow (core + tema activo)."
    echo -e "  ${CYAN}create <nombre>${RESET}           Genera el esqueleto Stow para un nuevo tema."
    echo -e "  ${CYAN}help, --help, -h${RESET}          Muestra este mensaje de ayuda."
    echo ""
    echo -e "${BOLD}Ejemplos:${RESET}"
    echo "  lunita-theme gui"
    echo "  lunita-theme list"
    echo "  lunita-theme apply modern-win11-theme"
    echo "  lunita-theme apply macos-theme"
    echo "  lunita-theme restow"
}

# ------------------------------------------------------------------------------
# Entrypoint
# ------------------------------------------------------------------------------
case "$1" in
    gui)
        cmd_gui
        ;;
    list|ls)
        cmd_list
        ;;
    current)
        cmd_current
        ;;
    apply|set)
        cmd_apply "$2"
        ;;
    stow)
        cmd_stow "$2"
        ;;
    unstow)
        cmd_unstow "$2"
        ;;
    restow)
        cmd_restow
        ;;
    sync)
        if command -v lunita-palette-sync >/dev/null 2>&1; then
            lunita-palette-sync sync
        elif [ -x "$DOTS_DIR/core/.local/bin/lunita-palette-sync" ]; then
            "$DOTS_DIR/core/.local/bin/lunita-palette-sync" sync
        fi
        ;;
    mode|toggle-mode)
        if command -v lunita-palette-sync >/dev/null 2>&1; then
            lunita-palette-sync "${2:-toggle}"
        elif [ -x "$DOTS_DIR/core/.local/bin/lunita-palette-sync" ]; then
            "$DOTS_DIR/core/.local/bin/lunita-palette-sync" "${2:-toggle}"
        fi
        ;;
    create)
        cmd_create "$2"
        ;;
    help|--help|-h|"")
        cmd_help
        ;;
    *)
        error "Comando desconocido: '$1'"
        echo "Ejecuta 'lunita-theme help' para ver la lista de comandos disponibles."
        exit 1
        ;;
esac
