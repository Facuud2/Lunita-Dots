#!/usr/bin/env python3
"""Toggle desktop widgets edit mode via IPC pipe, auto-starting the widgets Quickshell daemon if needed."""

import os
from pathlib import Path
import subprocess
import sys
import time


def resolve_dots_dir() -> Path:
    script_path = Path(__file__).resolve()
    for parent in script_path.parents:
        if (parent / "themes").is_dir() and (parent / "core").is_dir():
            return parent
    return script_path.parent.parent.parent


def get_active_theme(dots_dir: Path) -> str:
    home = Path.home()
    state_files = [
        home / ".config/lunita/current_theme",
        dots_dir / ".lunita-theme",
        home / ".lunita-theme",
    ]
    for sf in state_files:
        if sf.is_file():
            try:
                val = sf.read_text(encoding="utf-8").strip()
                if val:
                    return val
            except Exception:
                pass
    return "lunita-default"


def resolve_widgets_config_dir() -> Path | None:
    home = Path.home()
    dots_dir = resolve_dots_dir()
    active_theme = get_active_theme(dots_dir)

    candidates = [
        home / ".config/quickshell/widgets",
        dots_dir / "themes" / active_theme / ".config/quickshell/widgets",
        dots_dir / "core/.config/quickshell/widgets",
        dots_dir / "themes/macos-theme/.config/quickshell/widgets",
    ]
    for cand in candidates:
        if (cand / "shell.qml").is_file():
            return cand
    return None


def send_ipc_command(pipe_path: Path, cmd: str) -> bool:
    if not pipe_path.exists():
        return False
    try:
        fd = os.open(str(pipe_path), os.O_WRONLY | os.O_NONBLOCK)
        try:
            os.write(fd, f"{cmd}\n".encode("utf-8"))
        finally:
            os.close(fd)
        return True
    except OSError:
        return False


def ensure_widgets_daemon_running() -> bool:
    cfg_dir = resolve_widgets_config_dir()
    if cfg_dir is None:
        return False
    try:
        subprocess.Popen(
            ["quickshell", "-d", "-n", "-p", str(cfg_dir)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return True
    except Exception:
        return False


def main() -> None:
    runtime_dir = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/lunita-{os.getuid()}")
    pipe_path = runtime_dir / "lunita_widgets_ipc.pipe"
    cmd = sys.argv[1] if len(sys.argv) > 1 else "toggle_edit"

    if send_ipc_command(pipe_path, cmd):
        return

    # If pipe wasn't ready or daemon isn't running, start the widgets daemon and wait for the IPC pipe
    if ensure_widgets_daemon_running():
        for _ in range(25):
            time.sleep(0.1)
            if send_ipc_command(pipe_path, cmd):
                return

    # Fallback: open the graphical widgets manager on the desktop tab
    try:
        subprocess.Popen(
            ["lunita-widgets-manager", "--tab", "desktop"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


if __name__ == "__main__":
    main()
