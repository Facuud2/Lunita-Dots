#!/usr/bin/env bash
# ==============================================================================
# 🔍 LUNITA SPOTLIGHT WRAPPER
# Gestor e invocador reactivo para el Spotlight de macOS en Quickshell
# ==============================================================================

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
get_dots_dir() {
    local d="$1"
    while [ "$d" != "/" ] && [ -n "$d" ]; do
        if [ -d "$d/themes" ] && [ -d "$d/core" ]; then
            echo "$d"
            return 0
        fi
        d="$(dirname "$d")"
    done
    return 1
}
DOTS_DIR="$(get_dots_dir "$SCRIPT_DIR" 2>/dev/null || (cd "$SCRIPT_DIR/.." && pwd))"

ACTION="${1:-toggle}"

SPOTLIGHT_PATH="$HOME/.config/quickshell/spotlight"
if [ ! -d "$SPOTLIGHT_PATH" ]; then
    CURRENT_THEME="$(cat "$DOTS_DIR/.lunita-theme" 2>/dev/null || cat "$HOME/.lunita-theme" 2>/dev/null || echo "macOS-Theme")"
    if [ -d "$DOTS_DIR/themes/$CURRENT_THEME/.config/quickshell/spotlight" ]; then
        SPOTLIGHT_PATH="$DOTS_DIR/themes/$CURRENT_THEME/.config/quickshell/spotlight"
    else
        SPOTLIGHT_PATH="$DOTS_DIR/themes/macOS-Theme/.config/quickshell/spotlight"
    fi
fi

# Detectar monitor enfocado
TARGET_MONITOR="${2:-}"
if [ -z "$TARGET_MONITOR" ]; then
    TARGET_MONITOR=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null || echo "")
fi

CALL_ACTION="$ACTION"
CALL_ARGS=()
if [ -n "$TARGET_MONITOR" ] && [[ "$ACTION" == "toggle" || "$ACTION" == "open" ]]; then
    CALL_ACTION="${ACTION}On"
    CALL_ARGS=("$TARGET_MONITOR")
fi

# 1. Si Spotlight ya está en ejecución, enviar comando IPC directamente
if pgrep -f "quickshell.*spotlight" >/dev/null 2>&1; then
    quickshell -p "$SPOTLIGHT_PATH" ipc call spotlight "$CALL_ACTION" "${CALL_ARGS[@]}" 2>/dev/null || \
    quickshell -p "$SPOTLIGHT_PATH" ipc call spotlight "$ACTION" 2>/dev/null || \
    quickshell ipc call spotlight "$ACTION" 2>/dev/null || true
    exit 0
fi

# 2. Si no está en ejecución, iniciarlo en modo daemon
quickshell -d -n -p "$SPOTLIGHT_PATH"

# Pequeña espera para inicializar socket IPC y abrir
sleep 0.15
quickshell -p "$SPOTLIGHT_PATH" ipc call spotlight "$CALL_ACTION" "${CALL_ARGS[@]}" 2>/dev/null || \
quickshell -p "$SPOTLIGHT_PATH" ipc call spotlight "$ACTION" 2>/dev/null || \
quickshell ipc call spotlight "$ACTION" 2>/dev/null || true
