#!/usr/bin/env bash
# ==============================================================================
# 🔍 LUNITA SPOTLIGHT WRAPPER
# Gestor e invocador reactivo para Spotlight basado en theme.json
# ==============================================================================

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
get_dots_dir() {
    local d="$1"
    while [ "$d" != "/" ] && [ -n "$d" ]; do
        if [ -d "$d/themes" ] && [ -d "$d/core" ]; then
            echo "$d"
            return 0
        fi
        d="$(dirname "$d")"
    done
    return 1
}
DOTS_DIR="$(get_dots_dir "$SCRIPT_DIR" 2>/dev/null || (cd "$SCRIPT_DIR/.." && pwd))"

get_active_theme() {
    if [ -f "$DOTS_DIR/.lunita-theme" ]; then
        tr -d '[:space:]' < "$DOTS_DIR/.lunita-theme"
    elif [ -f "$HOME/.config/lunita/current_theme" ]; then
        tr -d '[:space:]' < "$HOME/.config/lunita/current_theme"
    elif [ -f "$HOME/.lunita-theme" ]; then
        tr -d '[:space:]' < "$HOME/.lunita-theme"
    else
        echo "lunita-default"
    fi
}

get_theme_component() {
    local comp="$1"
    local theme
    theme="$(get_active_theme)"
    local theme_file="$DOTS_DIR/themes/$theme/theme.json"

    if [ ! -f "$theme_file" ]; then
        echo ""
        return 0
    fi

    if command -v jq >/dev/null 2>&1; then
        jq -r --arg c "$comp" '.components[$c] // empty' "$theme_file" 2>/dev/null || echo ""
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c "import json; d=json.load(open('$theme_file')); print(d.get('components', {}).get('$comp', '') or '')" 2>/dev/null || echo ""
    fi
}

ACTION="${1:-toggle}"
ACTIVE_THEME="$(get_active_theme)"
SPOTLIGHT_COMP="$(get_theme_component "spotlight")"

# Si el tema actual no tiene spotlight declarado
if [ -z "$SPOTLIGHT_COMP" ] || [ "$SPOTLIGHT_COMP" = "null" ]; then
    BAR_COMP="$(get_theme_component "bar")"
    # Si el tema posee Dynamic Island en la barra, SUPER+SPACE conmuta la isla
    if [[ "$BAR_COMP" == *"island"* ]]; then
        TARGET_MONITOR="${2:-}"
        if [ -z "$TARGET_MONITOR" ]; then
            TARGET_MONITOR=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null || echo "")
        fi

        CALL_ACTION="$ACTION"
        CALL_ARGS=()
        if [ -n "$TARGET_MONITOR" ] && [[ "$ACTION" == "toggle" || "$ACTION" == "open" ]]; then
            CALL_ACTION="${ACTION}On"
            CALL_ARGS=("$TARGET_MONITOR")
        fi

        quickshell -p "$HOME/.config/quickshell/bar" ipc call bar "$CALL_ACTION" "${CALL_ARGS[@]}" 2>/dev/null || \
        quickshell -p "$HOME/.config/quickshell/bar" ipc call bar "$ACTION" 2>/dev/null || \
        quickshell ipc call bar "$ACTION" 2>/dev/null || true
    fi
    exit 0
fi

# Soporte para AGS si el tema lo especificara
if [[ "$SPOTLIGHT_COMP" == ags-* ]]; then
    if command -v ags >/dev/null 2>&1; then
        ags request toggle-island 2>/dev/null || true
    fi
    exit 0
fi

# Para componentes Quickshell
SPOTLIGHT_PATH="$HOME/.config/quickshell/spotlight"
if [ ! -d "$SPOTLIGHT_PATH" ]; then
    if [ -d "$DOTS_DIR/themes/$ACTIVE_THEME/.config/quickshell/spotlight" ]; then
        SPOTLIGHT_PATH="$DOTS_DIR/themes/$ACTIVE_THEME/.config/quickshell/spotlight"
    else
        # Si no existe en el tema activo, salir silenciosamente sin invocar otros temas
        exit 0
    fi
fi

# Detectar monitor enfocado
TARGET_MONITOR="${2:-}"
if [ -z "$TARGET_MONITOR" ]; then
    TARGET_MONITOR=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null || echo "")
fi

CALL_ACTION="$ACTION"
CALL_ARGS=()
if [ -n "$TARGET_MONITOR" ] && [[ "$ACTION" == "toggle" || "$ACTION" == "open" ]]; then
    CALL_ACTION="${ACTION}On"
    CALL_ARGS=("$TARGET_MONITOR")
fi

# 1. Si Spotlight ya está en ejecución, enviar comando IPC directamente
if pgrep -u "$UID" -f "quickshell.*spotlight" >/dev/null 2>&1; then
    quickshell -p "$SPOTLIGHT_PATH" ipc call spotlight "$CALL_ACTION" "${CALL_ARGS[@]}" 2>/dev/null || \
    quickshell -p "$SPOTLIGHT_PATH" ipc call spotlight "$ACTION" 2>/dev/null || \
    quickshell ipc call spotlight "$ACTION" 2>/dev/null || true
    exit 0
fi

# 2. Si no está en ejecución, iniciarlo en modo daemon
quickshell -d -n -p "$SPOTLIGHT_PATH" </dev/null >/dev/null 2>&1 &
disown -h $! 2>/dev/null || true

# Pequeña espera para inicializar socket IPC y abrir
sleep 0.15
quickshell -p "$SPOTLIGHT_PATH" ipc call spotlight "$CALL_ACTION" "${CALL_ARGS[@]}" 2>/dev/null || \
quickshell -p "$SPOTLIGHT_PATH" ipc call spotlight "$ACTION" 2>/dev/null || \
quickshell ipc call spotlight "$ACTION" 2>/dev/null || true
