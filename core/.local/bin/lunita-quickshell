#!/usr/bin/env bash
# ==============================================================================
# 🚀 LUNITA QUICKSHELL DAEMON & PROCESS MANAGER
# Control unificado de procesos e inicio de componentes Quickshell para Lunita-Dots
# Basado estrictamente en las declaraciones autoritarias de theme.json
# ==============================================================================

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
get_dots_dir() {
    local d="$1"
    while [ "$d" != "/" ] && [ -n "$d" ]; do
        if [ -d "$d/themes" ] && [ -d "$d/core" ]; then
            echo "$d"
            return 0
        fi
        d="$(dirname "$d")"
    done
    return 1
}
DOTS_DIR="$(get_dots_dir "$SCRIPT_DIR" 2>/dev/null || (cd "$SCRIPT_DIR/.." && pwd))"

# Colores y estilo
BOLD="\033[1m"
GREEN="\033[32m"
BLUE="\033[34m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
MAGENTA="\033[35m"
RESET="\033[0m"

info() { echo -e "${CYAN}ℹ${RESET} $1"; }
success() { echo -e "${GREEN}✓${RESET} $1"; }
warn() { echo -e "${YELLOW}⚠${RESET} $1"; }
error() { echo -e "${RED}✗${RESET} $1" >&2; }

# Componentes Quickshell candidatos para modo daemon continuo
DAEMON_COMPONENTS=("bar" "dock" "notifications" "osd" "spotlight" "launcher" "widgets" "clipboard")

get_active_theme() {
    if [ -f "$HOME/.config/lunita/current_theme" ]; then
        tr -d '[:space:]' < "$HOME/.config/lunita/current_theme"
    elif [ -L "$HOME/.config/quickshell/bar" ]; then
        local target
        target="$(readlink -f "$HOME/.config/quickshell/bar" 2>/dev/null || true)"
        if [[ "$target" =~ /themes/([^/]+)/ ]]; then
            echo "${BASH_REMATCH[1]}"
            return 0
        fi
        echo "lunita-default"
    elif [ -f "$DOTS_DIR/.lunita-theme" ]; then
        tr -d '[:space:]' < "$DOTS_DIR/.lunita-theme"
    elif [ -f "$HOME/.lunita-theme" ]; then
        tr -d '[:space:]' < "$HOME/.lunita-theme"
    else
        echo "lunita-default"
    fi
}

is_component_enabled_in_theme() {
    local comp="$1"
    local theme
    theme="$(get_active_theme)"
    local theme_file="$DOTS_DIR/themes/$theme/theme.json"

    if [ ! -f "$theme_file" ]; then
        [ -d "$HOME/.config/quickshell/$comp" ]
        return $?
    fi

    local val=""
    if command -v jq >/dev/null 2>&1; then
        val=$(jq -r --arg c "$comp" '.components[$c] // empty' "$theme_file" 2>/dev/null || echo "")
    elif command -v python3 >/dev/null 2>&1; then
        val=$(python3 -c "import json; d=json.load(open('$theme_file')); print(d.get('components', {}).get('$comp', '') or '')" 2>/dev/null || echo "")
    fi

    if [ -z "$val" ] || [ "$val" = "null" ] || [ "$val" = "false" ] || [ "$val" = "none" ]; then
        return 1
    fi

    # Si está asignado a otro subsistema, ignorarlo para Quickshell
    if [[ "$val" == ags-* || "$val" == eww-* || "$val" == rofi-* || "$val" == wlogout-* ]]; then
        return 1
    fi

    # Verificar existencia real de la configuración
    if [ -d "$HOME/.config/quickshell/$comp" ] || [ -d "$DOTS_DIR/themes/$theme/.config/quickshell/$comp" ] || [ -d "$DOTS_DIR/core/.config/quickshell/$comp" ]; then
        return 0
    fi

    return 1
}

get_qs_bin() {
    if command -v quickshell &>/dev/null; then
        echo "quickshell"
    elif command -v qs &>/dev/null; then
        echo "qs"
    elif [ -x "/usr/bin/quickshell" ]; then
        echo "/usr/bin/quickshell"
    else
        echo ""
    fi
}

wait_for_wayland() {
    local max_attempts=50
    local attempt=0
    local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

    while [ "$attempt" -lt "$max_attempts" ]; do
        if [ -n "$WAYLAND_DISPLAY" ] && [ -S "$runtime_dir/$WAYLAND_DISPLAY" ]; then
            return 0
        fi

        local found_sock
        found_sock=$(find "$runtime_dir" -maxdepth 1 -name "wayland-*" -type s 2>/dev/null | head -n 1 || true)
        if [ -n "$found_sock" ]; then
            export WAYLAND_DISPLAY="$(basename "$found_sock")"
            return 0
        fi

        sleep 0.1
        attempt=$((attempt + 1))
    done

    warn "No se detectó un socket Wayland tras esperar en $runtime_dir"
    return 1
}

ensure_display() {
    if [ -z "${DISPLAY:-}" ]; then
        local disp=""
        if command -v systemctl >/dev/null 2>&1; then
            disp="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^DISPLAY=//p' | head -n 1 || true)"
        fi
        if [ -z "$disp" ]; then
            for s in /tmp/.X11-unix/X*[0-9]; do
                if [ -S "$s" ] && [ -O "$s" ]; then
                    disp=":${s##*X}"
                    break
                fi
            done
        fi
        if [ -n "$disp" ]; then
            export DISPLAY="$disp"
        fi
    fi
}

get_component_pid() {
    local comp="$1"
    local pid=""

    # 1. Consultar IPC nativo de Quickshell
    if command -v quickshell &>/dev/null; then
        pid=$(quickshell list --all 2>/dev/null | awk -v c="$comp" '
            /Instance/ { cur_pid="" }
            /Process ID:/ { cur_pid=$3 }
            /Config path:/ && $0 ~ "/quickshell/" c { print cur_pid; exit }
        ')
    fi

    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "$pid"
        return 0
    fi

    # 2. Inspeccionar /proc directamente (sin falsos positivos de pgrep)
    local pids
    pids=$(pgrep -u "$UID" -x quickshell 2>/dev/null || pgrep -u "$UID" -x qs 2>/dev/null || true)
    for p in $pids; do
        if [ -f "/proc/$p/cmdline" ] && tr '\0' ' ' < "/proc/$p/cmdline" | grep -q "quickshell.*[/-]$comp"; then
            echo "$p"
            return 0
        fi
    done
    return 1
}

is_component_running() {
    local comp="$1"
    local pid
    pid="$(get_component_pid "$comp" 2>/dev/null || true)"
    [ -n "$pid" ]
}

start_component() {
    local comp="$1"
    local config_dir="$HOME/.config/quickshell/$comp"
    local qs_bin
    qs_bin="$(get_qs_bin)"

    if [ -z "$qs_bin" ]; then
        error "Quickshell no está instalado en el sistema."
        return 1
    fi

    if [ ! -d "$config_dir" ]; then
        local current_theme
        current_theme="$(get_active_theme)"
        if [ -d "$DOTS_DIR/themes/$current_theme/.config/quickshell/$comp" ]; then
            config_dir="$DOTS_DIR/themes/$current_theme/.config/quickshell/$comp"
        elif [ -d "$DOTS_DIR/core/.config/quickshell/$comp" ]; then
            config_dir="$DOTS_DIR/core/.config/quickshell/$comp"
        else
            return 0
        fi
    fi

    if is_component_running "$comp"; then
        info "Quickshell [$comp] ya está en ejecución."
        return 0
    fi

    "$qs_bin" -d -n -p "$config_dir" >/dev/null 2>&1
    success "Iniciado Quickshell [$comp]"
}

stop_component() {
    local comp="$1"
    local pid
    pid="$(get_component_pid "$comp" 2>/dev/null || true)"
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
        success "Detenido Quickshell [$comp] (PID: $pid)"
    fi
    if [ "$comp" = "osd" ]; then
        pkill -u "$UID" -f "osd_listener.py" 2>/dev/null || true
    fi
}

cmd_start() {
    local qs_bin
    qs_bin="$(get_qs_bin)"

    if [ -z "$qs_bin" ]; then
        error "Quickshell no está instalado en el sistema."
        exit 1
    fi

    wait_for_wayland
    ensure_display

    local current_theme
    current_theme="$(get_active_theme)"
    info "Iniciando componentes Quickshell para el tema: ${BOLD}$current_theme${RESET}"

    # 1. Detener procesos huérfanos que NO pertenezcan al tema activo
    for comp in "${DAEMON_COMPONENTS[@]}"; do
        if ! is_component_enabled_in_theme "$comp"; then
            if is_component_running "$comp"; then
                info "Deteniendo componente inactivo en este tema: $comp"
                stop_component "$comp"
            fi
        fi
    done

    # 2. Iniciar únicamente los componentes declarados para este tema
    for comp in "${DAEMON_COMPONENTS[@]}"; do
        if is_component_enabled_in_theme "$comp"; then
            start_component "$comp"
        fi
    done
}

cmd_stop() {
    info "Deteniendo todas las instancias de Quickshell..."
    for comp in "${DAEMON_COMPONENTS[@]}"; do
        stop_component "$comp"
    done
    pkill -u "$UID" -x quickshell 2>/dev/null || true
    pkill -u "$UID" -x qs 2>/dev/null || true
    pkill -u "$UID" -f "osd_listener.py" 2>/dev/null || true
    success "Instancias de Quickshell finalizadas."
}

cmd_restart() {
    cmd_stop
    sleep 0.4
    cmd_start
}

cmd_status() {
    local current_theme
    current_theme="$(get_active_theme)"
    echo -e "${BOLD}${MAGENTA}🌙 Estado de Procesos Quickshell (Tema: $current_theme)${RESET}"
    echo "=================================================="
    for comp in "${DAEMON_COMPONENTS[@]}"; do
        local pid
        pid="$(get_component_pid "$comp" 2>/dev/null || true)"
        if is_component_enabled_in_theme "$comp"; then
            if [ -n "$pid" ]; then
                echo -e "  ${GREEN}●${RESET} ${BOLD}$comp${RESET}: ${GREEN}Activo${RESET} (PID: $pid)"
            else
                echo -e "  ${RED}○${RESET} ${BOLD}$comp${RESET}: ${RED}Inactivo${RESET}"
            fi
        else
            if [ -n "$pid" ]; then
                echo -e "  ${YELLOW}⚠${RESET} ${BOLD}$comp${RESET}: ${YELLOW}Huérfano ejecutándose (no configurado en este tema)${RESET} (PID: $pid)"
            else
                echo -e "  ${YELLOW}−${RESET} $comp: No configurado en este tema"
            fi
        fi
    done
}

case "$1" in
    start|autostart|launch)
        cmd_start
        ;;
    stop|kill)
        cmd_stop
        ;;
    restart|reload)
        cmd_restart
        ;;
    status|list)
        cmd_status
        ;;
    *)
        echo "Uso: lunita-quickshell {start|stop|restart|status}"
        exit 1
        ;;
esac
