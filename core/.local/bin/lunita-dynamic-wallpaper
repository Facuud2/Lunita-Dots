#!/usr/bin/env bash
# ==============================================================================
# 🌅🌙 LUNITA DYNAMIC WALLPAPER (Compat Wrapper)
# Delega en lunita-wallpaper de forma 100% libre de demonios bloqueantes.
# ==============================================================================

set -euo pipefail

# Limpiar PID file legacy si existía
PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/lunita-dynamic-wallpaper.pid"
rm -f "$PID_FILE" 2>/dev/null || true

ACTION="${1:-init}"
shift || true

case "$ACTION" in
    init|restore)
        exec lunita-wallpaper restore
        ;;
    apply|now|"")
        exec lunita-wallpaper apply
        ;;
    daemon|loop|watch)
        echo "Aviso: Los demonios en bucle continuo fueron descontinuados para evitar bloqueos en el apagado del sistema."
        echo "Aplicando wallpaper horario de forma segura bajo demanda..."
        exec lunita-wallpaper apply
        ;;
    stop)
        # Modo stop no-op ya que no hay demonio persistente
        echo "Demonio de wallpaper no requerido (modo One-Shot activo)."
        exit 0
        ;;
    test)
        exec lunita-wallpaper apply
        ;;
    status)
        exec lunita-wallpaper status
        ;;
    set|set-preset)
        exec lunita-wallpaper apply
        ;;
    *)
        exec lunita-wallpaper "$ACTION" "$@"
        ;;
esac
