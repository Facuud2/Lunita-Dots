#!/usr/bin/env bash
# ==============================================================================
# 🌅🌙 LUNITA TIME-BASED DYNAMIC WALLPAPER
# Cambia automáticamente el wallpaper según la hora del día (Morning, Afternoon, Night)
# ==============================================================================

set -e

# Cargar configuración persistente si existe
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lunita"
CONFIG_FILE="$CONFIG_DIR/wallpaper.conf"
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE" 2>/dev/null || true
fi

# Archivo PID para control de instancia del demonio
PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/lunita-dynamic-wallpaper.pid"

is_daemon_running() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# Configuración por defecto de horarios (formato 24h, solo hora entera)
# Morning:   06:00 - 12:59
# Afternoon: 13:00 - 19:59
# Night:     20:00 - 05:59
MORNING_HOUR="${MORNING_HOUR:-6}"
AFTERNOON_HOUR="${AFTERNOON_HOUR:-13}"
NIGHT_HOUR="${NIGHT_HOUR:-20}"

# Preset por defecto (ej: 'apple' -> apple_morning, apple_afternoon, apple_night)
PRESET="${WALLPAPER_PRESET:-apple}"

# Transición por defecto para awww / swww
TRANSITION_TYPE="${TRANSITION_TYPE:-fade}"
TRANSITION_DURATION="${TRANSITION_DURATION:-2.0}"
TRANSITION_FPS="${TRANSITION_FPS:-60}"

# Colores para CLI
BOLD="\033[1m"
GREEN="\033[32m"
BLUE="\033[34m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
MAGENTA="\033[35m"
RESET="\033[0m"

# Directorio de wallpapers: busca en varias ubicaciones estándar
find_wallpaper_dir() {
    # 1. Si está definido explícitamente y existe
    if [ -n "$WALLPAPER_DIR" ] && [ -d "$WALLPAPER_DIR" ]; then
        echo "$WALLPAPER_DIR"
        return 0
    fi

    # 2. Si existe el enlace simbólico del tema activo (~/.config/lunita/wallpaper)
    local theme_wall_dir="$HOME/.config/lunita/wallpaper"
    if [ -d "$theme_wall_dir" ]; then
        local has_theme_imgs
        has_theme_imgs=$(find -L "$theme_wall_dir" -maxdepth 2 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) 2>/dev/null | head -n 1)
        if [ -n "$has_theme_imgs" ]; then
            echo "$theme_wall_dir"
            return 0
        fi
    fi

    # 3. Si quickpaper config.json existe y define wallpaper_path
    local qp_config="$HOME/.config/quickshell/hyprquickpaper/config.json"
    if [ -f "$qp_config" ]; then
        local qp_dir
        qp_dir=$(grep -o '"wallpaper_path": *"[^"]*"' "$qp_config" 2>/dev/null | cut -d'"' -f4 | sed "s|^~|$HOME|")
        if [ -n "$qp_dir" ] && [ -d "$qp_dir" ]; then
            echo "$qp_dir"
            return 0
        fi
    fi

    # 3. Ubicaciones estándar en el Home del usuario
    local candidate_dirs=(
        "$HOME/Imagenes/Wallpapers"
        "$HOME/Imágenes/Wallpapers"
        "$HOME/Pictures/Wallpapers"
        "$HOME/Imágenes"
        "$HOME/Imagenes"
        "$HOME/Pictures"
    )

    # Priorizar aquellos que realmente contengan imágenes
    for dir in "${candidate_dirs[@]}"; do
        if [ -d "$dir" ]; then
            local has_imgs
            has_imgs=$(find "$dir" -maxdepth 2 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.avif" -o -iname "*.jxl" \) 2>/dev/null | head -n 1)
            if [ -n "$has_imgs" ]; then
                echo "$dir"
                return 0
            fi
        fi
    done

    # Si ninguno contiene imágenes aún, usar el primero existente
    for dir in "${candidate_dirs[@]}"; do
        if [ -d "$dir" ]; then
            echo "$dir"
            return 0
        fi
    done

    echo "$HOME/Imagenes/Wallpapers"
}

WALLPAPER_DIR="$(find_wallpaper_dir)"
WALLPAPER_DIR="${WALLPAPER_DIR%/}"

# Detectar presets dinámicos disponibles en el directorio
detect_available_presets() {
    if [ ! -d "$WALLPAPER_DIR" ]; then
        return 0
    fi
    find "$WALLPAPER_DIR" -maxdepth 2 -type f \( \
        -iname "*_morning.*" -o -iname "*_afternoon.*" -o -iname "*_night.*" -o \
        -iname "*_day.*" -o -iname "*_dark.*" -o -iname "*_light.*" \
    \) 2>/dev/null | \
        sed -E 's#.*/([^/]+)_(morning|afternoon|night|day|dark|light)\.[a-zA-Z0-9]+$#\1#I' | sort -u
}

# Determinar el período según la hora actual
get_current_slot() {
    local hour
    hour=$(date +%-H)

    if [ "$hour" -ge "$MORNING_HOUR" ] && [ "$hour" -lt "$AFTERNOON_HOUR" ]; then
        echo "morning"
    elif [ "$hour" -ge "$AFTERNOON_HOUR" ] && [ "$hour" -lt "$NIGHT_HOUR" ]; then
        echo "afternoon"
    else
        echo "night"
    fi
}

# Encontrar el archivo de wallpaper correspondiente a un slot y preset
get_wallpaper_file() {
    local slot="$1"
    local preset="${2:-$PRESET}"
    local extensions=("jpg" "jpeg" "png" "webp" "jxl" "avif")

    # Si el preset solicitado no existe en el directorio pero hay otros presets,
    # evaluar si usar el primer preset disponible
    if [ -n "$preset" ] && [ -d "$WALLPAPER_DIR" ]; then
        local preset_match
        preset_match=$(find "$WALLPAPER_DIR" -maxdepth 2 -type f -iname "${preset}_*" 2>/dev/null | head -n 1)
        if [ -z "$preset_match" ]; then
            local available_preset
            available_preset=$(detect_available_presets | head -n 1)
            if [ -n "$available_preset" ]; then
                preset="$available_preset"
            fi
        fi
    fi

    # Definir sinónimos y variantes para cada slot
    local aliases=("$slot")
    case "$slot" in
        morning)
            aliases+=("day" "light" "sunrise" "dawn")
            ;;
        afternoon)
            aliases+=("day" "light" "noon" "midday" "morning")
            ;;
        night)
            aliases+=("dark" "evening" "sunset" "dusk")
            ;;
    esac

    # 1. Búsqueda exacta con preset: ej. apple_morning.jpg, apple_day.jpg
    if [ -n "$preset" ]; then
        for alias in "${aliases[@]}"; do
            for ext in "${extensions[@]}"; do
                local target="$WALLPAPER_DIR/${preset}_${alias}.${ext}"
                if [ -f "$target" ]; then
                    echo "$target"
                    return 0
                fi
            done
        done
    fi

    # 2. Búsqueda exacta sin preset: ej. morning.jpg, day.png
    for alias in "${aliases[@]}"; do
        for ext in "${extensions[@]}"; do
            local target="$WALLPAPER_DIR/${alias}.${ext}"
            if [ -f "$target" ]; then
                echo "$target"
                return 0
            fi
        done
    done

    # 3. Búsqueda con glob / find case-insensitive
    if [ -n "$preset" ]; then
        for alias in "${aliases[@]}"; do
            local found
            found=$(find "$WALLPAPER_DIR" -maxdepth 2 -type f -iname "*${preset}*${alias}*" 2>/dev/null | head -n 1)
            if [ -n "$found" ] && [ -f "$found" ]; then
                echo "$found"
                return 0
            fi
        done
    fi

    for alias in "${aliases[@]}"; do
        local found
        found=$(find "$WALLPAPER_DIR" -maxdepth 2 -type f -iname "*${alias}*" 2>/dev/null | head -n 1)
        if [ -n "$found" ] && [ -f "$found" ]; then
            echo "$found"
            return 0
        fi
    done

    # 4. Fallback inteligente: buscar CUALQUIER wallpaper existente en WALLPAPER_DIR
    # Esto asegura que si existen fondos en la carpeta (wallpaper1.png, etc.), NUNCA se quede en blanco
    if [ -d "$WALLPAPER_DIR" ]; then
        local any_wall
        any_wall=$(find "$WALLPAPER_DIR" -maxdepth 2 -type f \( \
            -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \
        \) 2>/dev/null | head -n 1)
        if [ -n "$any_wall" ] && [ -f "$any_wall" ]; then
            echo "$any_wall"
            return 0
        fi
    fi

    # 5. Fallback final: wallpaper de configuración actual
    if [ -f "$HOME/.config/hypr/current_wallpaper.png" ]; then
        echo "$HOME/.config/hypr/current_wallpaper.png"
        return 0
    fi

    echo ""
}

# Asegurar que el demonio backend esté corriendo y listo para recibir peticiones
ensure_backend() {
    if command -v awww-daemon &>/dev/null; then
        if ! pgrep -x awww-daemon >/dev/null; then
            awww-daemon &
        fi
        # Esperar hasta 3 segundos a que el socket responda
        for _ in {1..30}; do
            if awww query >/dev/null 2>&1; then
                return 0
            fi
            sleep 0.1
        done
        return 0
    elif command -v swww-daemon &>/dev/null; then
        if ! pgrep -x swww-daemon >/dev/null; then
            swww-daemon &
        fi
        for _ in {1..30}; do
            if swww query >/dev/null 2>&1; then
                return 0
            fi
            sleep 0.1
        done
        return 0
    fi
}

# Aplicar el wallpaper al sistema
apply_wallpaper() {
    local wall_path="$1"
    local force="${2:-false}"

    if [ -z "$wall_path" ] || [ ! -f "$wall_path" ]; then
        echo -e "${RED}✗ Error:${RESET} No se encontró archivo de fondo de pantalla en: '$wall_path'" >&2
        return 1
    fi

    # Garantizar que el backend está corriendo
    ensure_backend

    # Verificar si ya está realmente desplegado en pantalla
    local is_already_displayed="false"
    if [ "$force" != "true" ]; then
        if command -v awww &>/dev/null; then
            if awww query 2>/dev/null | grep -Fq "$wall_path"; then
                is_already_displayed="true"
            fi
        elif command -v swww &>/dev/null; then
            if swww query 2>/dev/null | grep -Fq "$wall_path"; then
                is_already_displayed="true"
            fi
        fi
    fi

    if [ "$is_already_displayed" = "true" ]; then
        return 0
    fi

    # Aplicar con awww / swww / hyprpaper
    if command -v awww &>/dev/null; then
        awww img "$wall_path" \
            --transition-type "$TRANSITION_TYPE" \
            --transition-duration "$TRANSITION_DURATION" \
            --transition-fps "$TRANSITION_FPS" 2>/dev/null || true
    elif command -v swww &>/dev/null; then
        swww img "$wall_path" \
            --transition-type "$TRANSITION_TYPE" \
            --transition-duration "$TRANSITION_DURATION" \
            --transition-fps "$TRANSITION_FPS" 2>/dev/null || true
    elif command -v hyprctl &>/dev/null && pgrep -x hyprpaper &>/dev/null; then
        hyprctl hyprpaper preload "$wall_path" 2>/dev/null || true
        hyprctl hyprpaper wallpaper ",$wall_path" 2>/dev/null || true
    fi

    # Guardar en la caché de Hyprquickpaper y sincronizar para hyprlock/smart_lock
    mkdir -p "$HOME/.cache/hyprquickpaper"
    echo "$wall_path" > "$HOME/.cache/hyprquickpaper/current_wallpaper"

    mkdir -p "$HOME/.config/hypr"
    cp -f "$wall_path" "$HOME/.config/hypr/current_wallpaper.png" 2>/dev/null || true

    return 0
}

# Modo de un solo disparo (One-shot apply)
cmd_apply() {
    local force="${1:-true}"
    local slot
    slot="$(get_current_slot)"
    local wall_file
    wall_file="$(get_wallpaper_file "$slot" "$PRESET")"

    if [ -z "$wall_file" ]; then
        echo -e "${RED}✗ No se encontró ningún wallpaper válido en ${WALLPAPER_DIR}${RESET}" >&2
        exit 1
    fi

    apply_wallpaper "$wall_file" "$force"
    echo -e "${GREEN}✓ Wallpaper dinámico (${slot}):${RESET} $(basename "$wall_file")"
}

# Inicialización completa (para autostart de Hyprland)
cmd_init() {
    ensure_backend
    cmd_apply "false"

    # Iniciar demonio de fondo si no está activo ya
    if ! is_daemon_running; then
        if command -v setsid &>/dev/null; then
            setsid "$0" daemon </dev/null >/dev/null 2>&1 &
        else
            nohup "$0" daemon </dev/null >/dev/null 2>&1 &
        fi
        echo -e "${GREEN}✓ Demonio de wallpaper dinámico iniciado en segundo plano.${RESET}"
    fi
}

# Detener el demonio
cmd_stop() {
    if is_daemon_running; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null || true
            rm -f "$PID_FILE"
            echo -e "${YELLOW}Demonio de Wallpaper Dinámico detenido (PID: $pid).${RESET}"
        fi
    else
        echo -e "${CYAN}No hay ningún demonio de Wallpaper Dinámico en ejecución.${RESET}"
    fi
}

# Modo prueba para forzar un slot específico
cmd_test() {
    local target_slot="$1"
    if [[ ! "$target_slot" =~ ^(morning|afternoon|night)$ ]]; then
        echo -e "${RED}Uso:${RESET} lunita-dynamic-wallpaper test <morning|afternoon|night>"
        exit 1
    fi

    local wall_file
    wall_file="$(get_wallpaper_file "$target_slot" "$PRESET")"
    if [ -z "$wall_file" ]; then
        echo -e "${RED}✗ No se encontró wallpaper para el slot '${target_slot}' con preset '${PRESET}' en ${WALLPAPER_DIR}${RESET}" >&2
        exit 1
    fi

    apply_wallpaper "$wall_file" "true"
    echo -e "${GREEN}✓ Test aplicado para slot [${target_slot}]:${RESET} $(basename "$wall_file")"
}

# Listar presets disponibles
cmd_presets() {
    echo -e "${BOLD}${MAGENTA}🎨 Presets Dinámicos Detectados:${RESET}"
    echo "=================================================="
    echo -e "${CYAN}Directorio:${RESET} $WALLPAPER_DIR"
    echo ""

    local presets
    presets=$(detect_available_presets)
    if [ -z "$presets" ]; then
        echo -e "${YELLOW}No se detectaron prefijos dinámicos con formato nombre_morning/afternoon/night.${RESET}"
    else
        while IFS= read -r p; do
            local mark=" "
            if [ "$p" = "$PRESET" ]; then
                mark="${GREEN}*${RESET}"
            fi
            echo -e "  $mark ${BOLD}$p${RESET}"
            echo -e "      🌅 Morning:   $(get_wallpaper_file "morning" "$p" || echo "No encontrado")"
            echo -e "      ☀️  Afternoon: $(get_wallpaper_file "afternoon" "$p" || echo "No encontrado")"
            echo -e "      🌙 Night:     $(get_wallpaper_file "night" "$p" || echo "No encontrado")"
        done <<< "$presets"
    fi
    echo ""
    echo -e "${CYAN}Preset actual activo:${RESET} ${BOLD}$PRESET${RESET}"
}

# Establecer y persistir un preset
cmd_set_preset() {
    local new_preset="$1"
    if [ -z "$new_preset" ]; then
        echo -e "${RED}Uso:${RESET} lunita-dynamic-wallpaper set-preset <nombre>"
        exit 1
    fi

    mkdir -p "$CONFIG_DIR"
    cat <<EOF > "$CONFIG_FILE"
# Configuración de Wallpaper Dinámico Lunita
WALLPAPER_PRESET="$new_preset"
WALLPAPER_DIR="$WALLPAPER_DIR"
MORNING_HOUR=$MORNING_HOUR
AFTERNOON_HOUR=$AFTERNOON_HOUR
NIGHT_HOUR=$NIGHT_HOUR
TRANSITION_TYPE="$TRANSITION_TYPE"
TRANSITION_DURATION="$TRANSITION_DURATION"
TRANSITION_FPS=$TRANSITION_FPS
EOF

    PRESET="$new_preset"
    echo -e "${GREEN}✓ Preset actualizado a:${RESET} ${BOLD}$new_preset${RESET}"
    cmd_apply "true"
}

# Estado actual
cmd_status() {
    local current_slot
    current_slot="$(get_current_slot)"
    local now_hour
    now_hour=$(date +"%H:%M")

    echo -e "${BOLD}${MAGENTA}🌙 Lunita-Dots — Dynamic Wallpaper Status${RESET}"
    echo "=================================================="
    echo -e "${CYAN}Hora actual:${RESET}      $now_hour"
    echo -e "${CYAN}Período activo:${RESET}   ${BOLD}${current_slot}${RESET}"
    echo -e "${CYAN}Preset:${RESET}           $PRESET"
    echo -e "${CYAN}Directorio:${RESET}       $WALLPAPER_DIR"
    echo ""
    echo -e "${BOLD}Esquema horario:${RESET}"
    echo -e "  🌅 Morning   ($MORNING_HOUR:00 - $((AFTERNOON_HOUR - 1)):59) -> $(get_wallpaper_file "morning" "$PRESET" || echo "No encontrado")"
    echo -e "  ☀️  Afternoon ($AFTERNOON_HOUR:00 - $((NIGHT_HOUR - 1)):59) -> $(get_wallpaper_file "afternoon" "$PRESET" || echo "No encontrado")"
    echo -e "  🌙 Night     ($NIGHT_HOUR:00 - $((MORNING_HOUR - 1)):59) -> $(get_wallpaper_file "night" "$PRESET" || echo "No encontrado")"
    echo ""

    if is_daemon_running; then
        local daemon_pid
        daemon_pid=$(cat "$PID_FILE" 2>/dev/null || true)
        echo -e "${GREEN}● Demonio:${RESET}        En ejecución (PID: $daemon_pid)"
    else
        echo -e "${YELLOW}○ Demonio:${RESET}        Detenido"
    fi

    if [ -f "$HOME/.cache/hyprquickpaper/current_wallpaper" ]; then
        echo -e "${YELLOW}Wallpaper en caché:${RESET} $(cat "$HOME/.cache/hyprquickpaper/current_wallpaper")"
    fi

    if command -v awww &>/dev/null; then
        echo -e "${CYAN}Wallpaper en pantalla (awww):${RESET}"
        awww query 2>/dev/null | sed 's/^/  /' || true
    fi
}

# Modo demonio (Daemon continuo)
cmd_daemon() {
    set +e
    # Evitar múltiples instancias del demonio
    if is_daemon_running; then
        local running_pid
        running_pid=$(cat "$PID_FILE" 2>/dev/null || true)
        echo -e "${YELLOW}Ya existe un demonio de Wallpaper Dinámico en ejecución (PID: $running_pid).${RESET}"
        exit 0
    fi

    echo "$$" > "$PID_FILE"
    trap 'rm -f "$PID_FILE"' EXIT INT TERM HUP

    echo -e "${GREEN}🚀 Iniciando demonio de Wallpaper Dinámico (PID: $$)...${RESET}"
    ensure_backend

    local last_slot=""

    # Aplicación inicial obligatoria
    local initial_slot
    initial_slot="$(get_current_slot)"
    local initial_file
    initial_file="$(get_wallpaper_file "$initial_slot" "$PRESET")"
    if [ -n "$initial_file" ]; then
        apply_wallpaper "$initial_file" "true"
        last_slot="$initial_slot"
        echo -e "[$(date +'%H:%M:%S')] ${GREEN}✓ Wallpaper inicial (${initial_slot}):${RESET} $(basename "$initial_file")"
    fi

    while true; do
        local slot
        slot="$(get_current_slot)"

        if [ "$slot" != "$last_slot" ]; then
            local wall_file
            wall_file="$(get_wallpaper_file "$slot" "$PRESET")"
            if [ -n "$wall_file" ]; then
                apply_wallpaper "$wall_file" "true"
                last_slot="$slot"
                echo -e "[$(date +'%H:%M:%S')] ${GREEN}✓ Cambiado a ${slot}:${RESET} $(basename "$wall_file")"
            fi
        fi

        # Comprobar cada 60 segundos
        sleep 60
    done
}

# Menú de ayuda
cmd_help() {
    echo -e "${BOLD}Uso:${RESET} lunita-dynamic-wallpaper [comando] [opciones]"
    echo ""
    echo -e "${BOLD}Comandos:${RESET}"
    echo "  init                    Inicializa backend, aplica wallpaper y arranca el demonio si no corre"
    echo "  apply, now              Aplica el fondo de pantalla correspondiente a la hora actual (por defecto)"
    echo "  daemon, loop            Ejecuta en segundo plano supervisando y alternando automáticamente"
    echo "  stop                    Detiene el demonio en segundo plano"
    echo "  presets, list           Lista los presets disponibles detectados en la carpeta de fondos"
    echo "  set-preset <nombre>     Configura y activa un preset dinámico de forma persistente"
    echo "  test <morning|afternoon|night>  Fuerza la visualización de un período específico"
    echo "  status                  Muestra información sobre los slots y fondos configurados"
    echo "  help, -h, --help        Muestra esta ayuda"
    echo ""
    echo -e "${BOLD}Variables de entorno o ~/.config/lunita/wallpaper.conf:${RESET}"
    echo "  WALLPAPER_DIR           Directorio de fondos (defecto: ~/Imagenes/Wallpapers)"
    echo "  WALLPAPER_PRESET        Prefijo de fondo (defecto: apple)"
    echo "  MORNING_HOUR            Hora inicio mañana (defecto: 6)"
    echo "  AFTERNOON_HOUR          Hora inicio tarde (defecto: 13)"
    echo "  NIGHT_HOUR              Hora inicio noche (defecto: 20)"
}

# Dispatcher principal
ACTION="${1:-apply}"

case "$ACTION" in
    init)
        cmd_init
        ;;
    apply|now|"")
        cmd_apply "true"
        ;;
    daemon|loop|watch)
        cmd_daemon
        ;;
    stop)
        cmd_stop
        ;;
    presets|list)
        cmd_presets
        ;;
    set-preset)
        cmd_set_preset "$2"
        ;;
    test)
        cmd_test "$2"
        ;;
    status|info)
        cmd_status
        ;;
    help|-h|--help)
        cmd_help
        ;;
    *)
        echo -e "${RED}Comando desconocido:${RESET} $ACTION"
        cmd_help
        exit 1
        ;;
esac
