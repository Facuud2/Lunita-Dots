    def show_toast(self, message: str):
        toast = Adw.Toast(title=message)
        self.toast_overlay.add_toast(toast)

    def build_ui(self):
        self.add_css_class("widgets-manager")

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_box.set_vexpand(True)
        main_box.set_hexpand(True)
        self.set_content(main_box)

        # ── HeaderBar ──
        header = Adw.HeaderBar()
        header.set_show_end_title_buttons(True)

        self.view_stack = Adw.ViewStack()
        switcher_title = Adw.ViewSwitcherTitle(
            stack=self.view_stack,
            title="Gestor de Widgets",
            subtitle="Configuración y Personalización"
        )
        header.set_title_widget(switcher_title)

        # Header action buttons
        restart_btn = Gtk.Button(icon_name="view-refresh-symbolic")
        restart_btn.set_tooltip_text("Reiniciar daemon de widgets (Quickshell)")
        restart_btn.connect("clicked", self.on_restart_widgets)
        header.pack_end(restart_btn)

        main_box.append(header)

        # ── Toast Overlay ──
        self.toast_overlay = Adw.ToastOverlay()
        self.toast_overlay.set_vexpand(True)
        self.toast_overlay.set_hexpand(True)
        main_box.append(self.toast_overlay)

        # ── ViewStack Pages ──
        self.toast_overlay.set_child(self.view_stack)
        self.view_stack.set_vexpand(True)
        self.view_stack.set_hexpand(True)

        # 1. Calendario
        cal_page = self.build_calendar_page()
        page1 = self.view_stack.add_titled(cal_page, "calendar", "Calendario")
        page1.set_icon_name("x-office-calendar")

        # 2. Salud y Actividad
        health_page = self.build_health_page()
        page2 = self.view_stack.add_titled(health_page, "health", "Salud y Actividad")
        page2.set_icon_name("emblem-favorite-symbolic")

        # 3. Notas y Agenda
        tt_page = self.build_timetable_page()
        page3 = self.view_stack.add_titled(tt_page, "timetable", "Notas & Agenda")
        page3.set_icon_name("accessories-text-editor-symbolic")

        # 4. GitHub
        git_page = self.build_github_page()
        page4 = self.view_stack.add_titled(git_page, "github", "GitHub")
        page4.set_icon_name("preferences-system-network-symbolic")

        # 5. Escritorio y Control
        desktop_page = self.build_desktop_page()
        page5 = self.view_stack.add_titled(desktop_page, "desktop", "Escritorio")
        page5.set_icon_name("user-desktop-symbolic")

    # =========================================================================
    # 📅 PÁGINA 1: CALENDARIO (Cuadrícula Mensual Completa con Marcadores)
    # =========================================================================
    def build_calendar_page(self) -> Gtk.Widget:
        now = date.today()
        self.cal_current_year = now.year
        self.cal_current_month = now.month
        self.cal_selected_date = None
        self.cal_day_buttons = {}

        page_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page_box.set_vexpand(True)
        page_box.set_hexpand(True)
        page_box.set_margin_top(16)
        page_box.set_margin_bottom(16)
        page_box.set_margin_start(20)
        page_box.set_margin_end(20)

        # ── Cabecera de Navegación del Calendario ──
        header_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        header_bar.add_css_class("wm-cal-header")

        nav_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        btn_prev = Gtk.Button(icon_name="go-previous-symbolic")
        btn_prev.add_css_class("wm-cal-header-btn")
        btn_prev.set_tooltip_text("Mes anterior")
        btn_prev.connect("clicked", lambda _: self.change_calendar_month(-1))

        btn_today = Gtk.Button(label="Hoy")
        btn_today.add_css_class("wm-cal-header-btn")
        btn_today.set_tooltip_text("Ir al mes actual")
        btn_today.connect("clicked", lambda _: self.reset_calendar_to_today())

        btn_next = Gtk.Button(icon_name="go-next-symbolic")
        btn_next.add_css_class("wm-cal-header-btn")
        btn_next.set_tooltip_text("Mes siguiente")
        btn_next.connect("clicked", lambda _: self.change_calendar_month(1))

        nav_box.append(btn_prev)
        nav_box.append(btn_today)
        nav_box.append(btn_next)
        header_bar.append(nav_box)

        self.cal_month_title_label = Gtk.Label()
        self.cal_month_title_label.add_css_class("title-2")
        self.cal_month_title_label.add_css_class("bold")
        self.cal_month_title_label.set_margin_start(8)
        header_bar.append(self.cal_month_title_label)

        # Espaciador expansible
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        header_bar.append(spacer)

        # Indicador de ayuda
        hint_lbl = Gtk.Label(label="Haz clic en cualquier día para abrir el panel lateral de eventos")
        hint_lbl.add_css_class("dim-label")
        hint_lbl.set_halign(Gtk.Align.END)
        header_bar.append(hint_lbl)

        page_box.append(header_bar)

        # Split Container: Izquierda (Calendario) + Derecha (Panel Lateral con Revealer)
        self.cal_split_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        self.cal_split_box.set_vexpand(True)
        self.cal_split_box.set_hexpand(True)

        # Columna Izquierda: Días de la semana + Grid mensual
        cal_left_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        cal_left_col.set_vexpand(True)
        cal_left_col.set_hexpand(True)

        weekday_grid = Gtk.Grid()
        weekday_grid.set_column_homogeneous(True)
        weekday_grid.set_column_spacing(8)
        for i, wname in enumerate(WEEKDAY_NAMES_ES):
            w_lbl = Gtk.Label(label=wname)
            w_lbl.add_css_class("wm-cal-weekday-label")
            w_lbl.set_halign(Gtk.Align.CENTER)
            weekday_grid.attach(w_lbl, i, 0, 1, 1)
        cal_left_col.append(weekday_grid)

        # Grid ScrolledWindow
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        scroll.set_hexpand(True)

        self.cal_grid = Gtk.Grid()
        self.cal_grid.set_column_homogeneous(True)
        self.cal_grid.set_row_homogeneous(True)
        self.cal_grid.set_column_spacing(8)
        self.cal_grid.set_row_spacing(8)
        self.cal_grid.set_vexpand(True)
        self.cal_grid.set_hexpand(True)

        scroll.set_child(self.cal_grid)
        cal_left_col.append(scroll)

        self.cal_split_box.append(cal_left_col)

        # Panel Lateral (Revealer con transición hacia la izquierda)
        self.cal_side_revealer = Gtk.Revealer()
        self.cal_side_revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_LEFT)
        self.cal_side_revealer.set_transition_duration(250)
        self.cal_side_revealer.set_reveal_child(False)

        side_panel_widget = self.build_calendar_side_panel()
        self.cal_side_revealer.set_child(side_panel_widget)
        self.cal_split_box.append(self.cal_side_revealer)

        page_box.append(self.cal_split_box)

        self.render_calendar_grid()

        return page_box

    def change_calendar_month(self, delta: int):
        self.cal_current_month += delta
        if self.cal_current_month > 12:
            self.cal_current_month = 1
            self.cal_current_year += 1
        elif self.cal_current_month < 1:
            self.cal_current_month = 12
            self.cal_current_year -= 1
        if hasattr(self, "cal_side_revealer") and self.cal_side_revealer.get_reveal_child():
            self.close_calendar_side_panel()
        self.render_calendar_grid()

    def reset_calendar_to_today(self):
        now = date.today()
        self.cal_current_year = now.year
        self.cal_current_month = now.month
        if hasattr(self, "cal_side_revealer") and self.cal_side_revealer.get_reveal_child():
            self.close_calendar_side_panel()
        self.render_calendar_grid()

    def render_calendar_grid(self):
        while child := self.cal_grid.get_first_child():
            self.cal_grid.remove(child)

        self.cal_day_buttons = {}

        m_name = MONTH_NAMES_ES[self.cal_current_month - 1]
        self.cal_month_title_label.set_text(f"{m_name} {self.cal_current_year}")

        cal = calendar.Calendar(firstweekday=0) # Lunes = 0
        month_weeks = cal.monthdayscalendar(self.cal_current_year, self.cal_current_month)
        today = date.today()
        all_events = self.read_calendar_file()

        for row_idx, week in enumerate(month_weeks):
            for col_idx, d in enumerate(week):
                if d == 0:
                    empty_box = Gtk.Box()
                    empty_box.add_css_class("wm-cal-day-cell")
                    empty_box.add_css_class("other-month")
                    empty_box.set_vexpand(True)
                    empty_box.set_hexpand(True)
                    self.cal_grid.attach(empty_box, col_idx, row_idx, 1, 1)
                    continue

                date_str = f"{self.cal_current_year:04d}-{self.cal_current_month:02d}-{d:02d}"
                is_today = (self.cal_current_year == today.year and
                            self.cal_current_month == today.month and
                            d == today.day)
                is_selected = (getattr(self, "cal_selected_date", None) == date_str)
                day_events = all_events.get(date_str, [])

                btn = Gtk.Button()
                btn.add_css_class("wm-cal-day-cell")
                if is_today:
                    btn.add_css_class("today")
                if is_selected:
                    btn.add_css_class("selected-day")
                btn.set_vexpand(True)
                btn.set_hexpand(True)

                self.cal_day_buttons[date_str] = btn

                cell_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)

                top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
                num_lbl = Gtk.Label(label=str(d))
                num_lbl.add_css_class("wm-cal-day-num")
                if is_today:
                    num_lbl.add_css_class("today")
                top_row.append(num_lbl)

                if day_events:
                    badge_lbl = Gtk.Label(label=f"{len(day_events)} ev")
                    badge_lbl.add_css_class("dim-label")
                    badge_lbl.set_halign(Gtk.Align.END)
                    badge_lbl.set_hexpand(True)
                    top_row.append(badge_lbl)

                cell_box.append(top_row)

                events_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                for ev in day_events[:3]:
                    chip = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
                    chip.add_css_class("wm-cal-chip")

                    shape_type = ev.get("shape", "circle")
                    shape_glyph = SHAPE_GLYPHS.get(shape_type, "●")
                    col = ev.get("color", "#0A84FF")

                    marker_lbl = Gtk.Label()
                    marker_lbl.set_markup(f"<span foreground='{col}'>{shape_glyph}</span>")
                    chip.append(marker_lbl)

                    title_lbl = Gtk.Label(label=ev.get("title", "Evento"))
                    title_lbl.set_ellipsize(Pango.EllipsizeMode.END)
                    title_lbl.set_halign(Gtk.Align.START)
                    title_lbl.set_hexpand(True)
                    chip.append(title_lbl)

                    events_box.append(chip)

                if len(day_events) > 3:
                    more_lbl = Gtk.Label(label=f"+{len(day_events) - 3} más")
                    more_lbl.add_css_class("dim-label")
                    more_lbl.set_halign(Gtk.Align.START)
                    events_box.append(more_lbl)

                cell_box.append(events_box)
                btn.set_child(cell_box)

                btn.connect("clicked", lambda _, ds=date_str: self.on_day_cell_clicked(ds))

                self.cal_grid.attach(btn, col_idx, row_idx, 1, 1)

    def on_day_cell_clicked(self, date_str: str):
        if getattr(self, "cal_selected_date", None) == date_str and self.cal_side_revealer.get_reveal_child():
            self.close_calendar_side_panel()
            return

        self.cal_selected_date = date_str

        for ds, btn in getattr(self, "cal_day_buttons", {}).items():
            if ds == date_str:
                btn.add_css_class("selected-day")
            else:
                btn.remove_css_class("selected-day")

        self.refresh_side_panel(date_str)
        self.cal_side_revealer.set_reveal_child(True)

    def close_calendar_side_panel(self):
        if hasattr(self, "cal_side_revealer"):
            self.cal_side_revealer.set_reveal_child(False)
        self.cal_selected_date = None
        for btn in getattr(self, "cal_day_buttons", {}).values():
            btn.remove_css_class("selected-day")

    def build_calendar_side_panel(self) -> Gtk.Widget:
        side_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        side_card.add_css_class("wm-cal-side-panel")
        side_card.set_size_request(370, -1)
        side_card.set_vexpand(True)

        # ── Cabecera del Panel Lateral ──
        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        hdr.add_css_class("wm-cal-side-header")

        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        titles.set_hexpand(True)
        self.cal_side_date_label = Gtk.Label(label="Fecha seleccionada")
        self.cal_side_date_label.add_css_class("title-3")
        self.cal_side_date_label.add_css_class("bold")
        self.cal_side_date_label.set_halign(Gtk.Align.START)

        self.cal_side_dayname_label = Gtk.Label(label="")
        self.cal_side_dayname_label.add_css_class("dim-label")
        self.cal_side_dayname_label.set_halign(Gtk.Align.START)

        titles.append(self.cal_side_date_label)
        titles.append(self.cal_side_dayname_label)
        hdr.append(titles)

        btn_close = Gtk.Button(icon_name="window-close-symbolic")
        btn_close.add_css_class("wm-cal-close-btn")
        btn_close.set_tooltip_text("Cerrar panel")
        btn_close.connect("clicked", lambda _: self.close_calendar_side_panel())
        hdr.append(btn_close)

        side_card.append(hdr)

        # ── Área con Scroll ──
        side_scroll = Gtk.ScrolledWindow()
        side_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        side_scroll.set_vexpand(True)
        side_scroll.set_hexpand(True)

        side_content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        side_scroll.set_child(side_content)
        side_card.append(side_scroll)

        # ── Sección 1: Eventos Programados ──
        sec_events_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl_events_title = Gtk.Label(label="Eventos Programados")
        lbl_events_title.add_css_class("wm-section-header")
        lbl_events_title.set_halign(Gtk.Align.START)
        sec_events_hdr.append(lbl_events_title)

        self.cal_side_badge = Gtk.Label(label="(0)")
        self.cal_side_badge.add_css_class("dim-label")
        sec_events_hdr.append(self.cal_side_badge)
        side_content.append(sec_events_hdr)

        self.cal_side_events_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        side_content.append(self.cal_side_events_list)

        # Separador visual
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        sep.set_margin_top(4)
        sep.set_margin_bottom(4)
        side_content.append(sep)

        # ── Sección 2: Añadir Nuevo Evento ──
        lbl_new_title = Gtk.Label(label="Nuevo Evento")
        lbl_new_title.add_css_class("wm-section-header")
        lbl_new_title.set_halign(Gtk.Align.START)
        side_content.append(lbl_new_title)

        form_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        # Título
        self.cal_entry_title = Gtk.Entry(placeholder_text="Título o nota del evento...")
        self.cal_entry_title.add_css_class("wm-cal-input")
        form_box.append(self.cal_entry_title)

        # Fila Horario y Categoría
        meta_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.cal_entry_time = Gtk.Entry(placeholder_text="Horario (ej: 15:00 o Todo el día)")
        self.cal_entry_time.add_css_class("wm-cal-input")
        self.cal_entry_time.set_hexpand(True)
        meta_row.append(self.cal_entry_time)

        self.cal_combo_cat = Gtk.DropDown.new_from_strings(CATEGORIES)
        meta_row.append(self.cal_combo_cat)
        form_box.append(meta_row)

        # Selector de Marcador Geométrico
        marker_sec = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        lbl_marker = Gtk.Label(label="Marcador Geométrico:")
        lbl_marker.set_halign(Gtk.Align.START)
        lbl_marker.add_css_class("dim-label")
        marker_sec.append(lbl_marker)

        shape_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        shape_row.set_homogeneous(True)
        self.cal_selected_shape = "circle"
        self.cal_shape_buttons = []

        def set_side_shape(s_val):
            self.cal_selected_shape = s_val
            for b, sv in self.cal_shape_buttons:
                if sv == s_val:
                    b.add_css_class("selected")
                else:
                    b.remove_css_class("selected")

        for s_code, s_label, _ in CALENDAR_SHAPES:
            s_btn = Gtk.Button(label=s_label)
            s_btn.add_css_class("wm-shape-btn")
            if s_code == self.cal_selected_shape:
                s_btn.add_css_class("selected")
            s_btn.connect("clicked", lambda _, sc=s_code: set_side_shape(sc))
            shape_row.append(s_btn)
            self.cal_shape_buttons.append((s_btn, s_code))

        marker_sec.append(shape_row)
        form_box.append(marker_sec)

        # Selector de Color
        color_sec = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        lbl_color = Gtk.Label(label="Color de Etiqueta:")
        lbl_color.set_halign(Gtk.Align.START)
        lbl_color.add_css_class("dim-label")
        color_sec.append(lbl_color)

        color_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        color_row.set_halign(Gtk.Align.START)
        self.cal_selected_color = CALENDAR_COLORS[0][0]
        self.cal_color_buttons = []

        def set_side_color(hex_col):
            self.cal_selected_color = hex_col
            for b, col in self.cal_color_buttons:
                if col == hex_col:
                    b.add_css_class("selected")
                else:
                    b.remove_css_class("selected")

        for i, (hex_col, name) in enumerate(CALENDAR_COLORS):
            btn = Gtk.Button()
            btn.add_css_class("wm-color-btn")
            btn.add_css_class(f"wm-col-{i}")
            if hex_col == self.cal_selected_color:
                btn.add_css_class("selected")
            btn.set_tooltip_text(name)
            btn.connect("clicked", lambda _, col=hex_col: set_side_color(col))
            color_row.append(btn)
            self.cal_color_buttons.append((btn, hex_col))

        color_sec.append(color_row)
        form_box.append(color_sec)

        # Botón Guardar
        self.cal_btn_save = Gtk.Button(label="Guardar Evento")
        self.cal_btn_save.add_css_class("wm-btn-primary")
        self.cal_btn_save.connect("clicked", self.on_save_calendar_event_clicked)
        form_box.append(self.cal_btn_save)

        side_content.append(form_box)

        return side_card

    def refresh_side_panel(self, date_str: str):
        try:
            d_obj = datetime.strptime(date_str, "%Y-%m-%d")
            dias_es = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"]
            meses_es = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"]
            fecha_bonita = f"{d_obj.day} de {meses_es[d_obj.month - 1]} {d_obj.year}"
            dia_nombre = dias_es[d_obj.weekday()]
        except Exception:
            fecha_bonita = date_str
            dia_nombre = ""

        self.cal_side_date_label.set_text(fecha_bonita)
        self.cal_side_dayname_label.set_text(dia_nombre)

        while child := self.cal_side_events_list.get_first_child():
            self.cal_side_events_list.remove(child)

        all_events = self.read_calendar_file()
        day_events = all_events.get(date_str, [])
        self.cal_side_badge.set_text(f"({len(day_events)})")

        if not day_events:
            empty_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            empty_box.add_css_class("wm-cal-empty-state")
            empty_box.set_halign(Gtk.Align.FILL)

            empty_lbl = Gtk.Label(label="Sin eventos para esta fecha")
            empty_lbl.add_css_class("bold")
            empty_lbl.add_css_class("dim-label")
            empty_box.append(empty_lbl)

            hint_sub = Gtk.Label(label="Usa el formulario inferior para registrar uno.")
            hint_sub.add_css_class("dim-label")
            empty_box.append(hint_sub)

            self.cal_side_events_list.append(empty_box)
            return

        for ev in day_events:
            card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            card.add_css_class("wm-cal-event-card")

            shape_type = ev.get("shape", "circle")
            shape_glyph = SHAPE_GLYPHS.get(shape_type, "●")
            col = ev.get("color", "#0A84FF")

            glyph_lbl = Gtk.Label()
            glyph_lbl.set_markup(f"<span foreground='{col}' font_desc='15'>{shape_glyph}</span>")
            glyph_lbl.set_valign(Gtk.Align.CENTER)
            card.append(glyph_lbl)

            info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            info_box.set_hexpand(True)

            t_lbl = Gtk.Label(label=ev.get("title", "Sin título"))
            t_lbl.set_halign(Gtk.Align.START)
            t_lbl.add_css_class("bold")
            t_lbl.set_wrap(True)
            info_box.append(t_lbl)

            meta_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            time_lbl = Gtk.Label(label=ev.get("time", "Todo el día"))
            time_lbl.add_css_class("dim-label")
            time_lbl.set_halign(Gtk.Align.START)
            meta_box.append(time_lbl)

            bullet_lbl = Gtk.Label(label="•")
            bullet_lbl.add_css_class("dim-label")
            meta_box.append(bullet_lbl)

            cat_lbl = Gtk.Label(label=ev.get("category", "General"))
            cat_lbl.add_css_class("dim-label")
            cat_lbl.set_halign(Gtk.Align.START)
            meta_box.append(cat_lbl)

            info_box.append(meta_box)
            card.append(info_box)

            del_btn = Gtk.Button(icon_name="user-trash-symbolic")
            del_btn.add_css_class("wm-cal-close-btn")
            del_btn.set_tooltip_text("Eliminar evento")
            del_btn.connect("clicked", lambda _, eid=ev.get("id"), ds=date_str: self.delete_calendar_event(ds, eid))
            card.append(del_btn)

            self.cal_side_events_list.append(card)

    def on_save_calendar_event_clicked(self, _):
        if not getattr(self, "cal_selected_date", None):
            self.show_toast("Selecciona un día en el calendario primero")
            return

        title = self.cal_entry_title.get_text().strip()
        if not title:
            self.show_toast("Por favor ingresa un título para el evento")
            return

        time_val = self.cal_entry_time.get_text().strip() or "Todo el día"
        cat_idx = self.cal_combo_cat.get_selected()
        cat_val = CATEGORIES[cat_idx] if cat_idx < len(CATEGORIES) else "General"
        col_val = getattr(self, "cal_selected_color", CALENDAR_COLORS[0][0])
        shape_val = getattr(self, "cal_selected_shape", "circle")

        all_events = self.read_calendar_file()
        if self.cal_selected_date not in all_events:
            all_events[self.cal_selected_date] = []

        new_ev_id = f"ev_{int(datetime.now().timestamp())}_{len(all_events[self.cal_selected_date])}"
        all_events[self.cal_selected_date].append({
            "id": new_ev_id,
            "title": title,
            "time": time_val,
            "category": cat_val,
            "color": col_val,
            "shape": shape_val
        })

        self.write_calendar_file(all_events)
        self.cal_entry_title.set_text("")
        self.cal_entry_time.set_text("")

        self.refresh_side_panel(self.cal_selected_date)
        self.render_calendar_grid()
        self.show_toast(f"Evento registrado para {self.cal_selected_date}")

    def delete_calendar_event(self, date_str: str, event_id: str):
        all_events = self.read_calendar_file()
        if date_str in all_events:
            all_events[date_str] = [e for e in all_events[date_str] if e.get("id") != event_id]
            if not all_events[date_str]:
                del all_events[date_str]
            self.write_calendar_file(all_events)

            if getattr(self, "cal_selected_date", None) == date_str:
                self.refresh_side_panel(date_str)
            self.render_calendar_grid()
            self.show_toast("Evento eliminado")

    def read_calendar_file(self) -> dict:
        if not CALENDAR_FILE.exists():
            return {}
        try:
            with open(CALENDAR_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}

    def write_calendar_file(self, data: dict):
        ensure_config_dir()
        with open(CALENDAR_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)

    # =========================================================================
    # 🏃 PÁGINA 2: SALUD y ACTIVIDAD (macOS Health-Style)
    # =========================================================================
    def build_health_page(self) -> Gtk.Widget:
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        content.set_margin_top(20)
        content.set_margin_bottom(20)
        content.set_margin_start(24)
        content.set_margin_end(24)
        scroll.set_child(content)

        health_data = self.load_health_data()

        # ── Grupo 1: Métricas Diarias y Metas de Anillos ──
        group_metrics = Adw.PreferencesGroup()
        group_metrics.set_title("Métricas de Salud y Actividad")
        group_metrics.set_description("Ajusta tus pasos, calorías quemadas, minutos de ejercicio e hidratación diaria.")

        # 1. Calorías Activas (Anillo Rojo)
        self.spin_cal = Adw.SpinRow.new_with_range(0, 5000, 25)
        self.spin_cal.set_title("Calorías Activas (kcal)")
        self.spin_cal.set_subtitle("Anillo Rojo • Energía consumida en movimiento")
        self.spin_cal.set_value(float(health_data.get("calories", 0)))
        group_metrics.add(self.spin_cal)

        self.spin_cal_goal = Adw.SpinRow.new_with_range(100, 5000, 50)
        self.spin_cal_goal.set_title("Meta Diaria de Calorías")
        self.spin_cal_goal.set_value(float(health_data.get("calories_goal", 600)))
        group_metrics.add(self.spin_cal_goal)

        # 2. Ejercicio (Anillo Verde)
        self.spin_ex = Adw.SpinRow.new_with_range(0, 720, 5)
        self.spin_ex.set_title("Tiempo de Ejercicio (minutos)")
        self.spin_ex.set_subtitle("Anillo Lima • Actividad física de alta intensidad")
        self.spin_ex.set_value(float(health_data.get("exercise", 0)))
        group_metrics.add(self.spin_ex)

        self.spin_ex_goal = Adw.SpinRow.new_with_range(10, 360, 5)
        self.spin_ex_goal.set_title("Meta Diaria de Ejercicio")
        self.spin_ex_goal.set_value(float(health_data.get("exercise_goal", 30)))
        group_metrics.add(self.spin_ex_goal)

        # 3. Pasos (Anillo Cian)
        self.spin_steps = Adw.SpinRow.new_with_range(0, 100000, 250)
        self.spin_steps.set_title("Pasos Totales")
        self.spin_steps.set_subtitle("Anillo Cian • Desplazamiento y caminata diaria")
        self.spin_steps.set_value(float(health_data.get("steps", 0)))
        group_metrics.add(self.spin_steps)

        self.spin_steps_goal = Adw.SpinRow.new_with_range(1000, 100000, 500)
        self.spin_steps_goal.set_title("Meta Diaria de Pasos")
        self.spin_steps_goal.set_value(float(health_data.get("steps_goal", 10000)))
        group_metrics.add(self.spin_steps_goal)

        # 4. Agua / Hidratación (Azul)
        self.spin_water = Adw.SpinRow.new_with_range(0.0, 10.0, 0.1)
        self.spin_water.set_title("Hidratación (Litros de Agua)")
        self.spin_water.set_subtitle("Consumo diario de agua")
        self.spin_water.set_value(float(health_data.get("water", 0.0)))
        group_metrics.add(self.spin_water)

        self.spin_water_goal = Adw.SpinRow.new_with_range(0.5, 10.0, 0.25)
        self.spin_water_goal.set_title("Meta Diaria de Agua (Litros)")
        self.spin_water_goal.set_value(float(health_data.get("water_goal", 2.5)))
        group_metrics.add(self.spin_water_goal)

        content.append(group_metrics)

        # ── Grupo 2: Incrementos Rápidos ──
        group_quick = Adw.PreferencesGroup()
        group_quick.set_title("Ajustes y Registro Rápido")
        group_quick.set_description("Suma cantidades directamente a las métricas de hoy.")

        row_quick = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row_quick.set_margin_top(4)

        btn_q_step = Gtk.Button(label="+500 Pasos")
        btn_q_step.connect("clicked", lambda _: self.spin_steps.set_value(self.spin_steps.get_value() + 500))
        row_quick.append(btn_q_step)

        btn_q_cal = Gtk.Button(label="+50 kcal")
        btn_q_cal.connect("clicked", lambda _: self.spin_cal.set_value(self.spin_cal.get_value() + 50))
        row_quick.append(btn_q_cal)

        btn_q_ex = Gtk.Button(label="+15 min Ejercicio")
        btn_q_ex.connect("clicked", lambda _: self.spin_ex.set_value(self.spin_ex.get_value() + 15))
        row_quick.append(btn_q_ex)

        btn_q_water = Gtk.Button(label="+0.25 L Agua")
        btn_q_water.connect("clicked", lambda _: self.spin_water.set_value(round(self.spin_water.get_value() + 0.25, 2)))
        row_quick.append(btn_q_water)

        btn_reset_all = Gtk.Button(label="Reiniciar Métricas a 0")
        btn_reset_all.add_css_class("wm-btn-danger")
        btn_reset_all.connect("clicked", self.on_reset_health_metrics)
        row_quick.append(btn_reset_all)

        group_quick.add(row_quick)
        content.append(group_quick)

        # Botón Guardar
        btn_save_health = Gtk.Button(label="Guardar y Actualizar Widget de Salud")
        btn_save_health.add_css_class("wm-btn-primary")
        btn_save_health.connect("clicked", self.on_save_health_data)
        content.append(btn_save_health)

        return scroll

    def load_health_data(self) -> dict:
        default_data = {
            "date": datetime.now().strftime("%Y-%m-%d"),
            "calories": 0,
            "calories_goal": 600,
            "exercise": 0,
            "exercise_goal": 30,
            "steps": 0,
            "steps_goal": 10000,
            "water": 0.0,
            "water_goal": 2.5
        }
        if HEALTH_FILE.exists():
            try:
                with open(HEALTH_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    default_data.update(data)
            except Exception:
                pass
        return default_data

    def on_reset_health_metrics(self, _):
        self.spin_cal.set_value(0)
        self.spin_ex.set_value(0)
        self.spin_steps.set_value(0)
        self.spin_water.set_value(0.0)
        try:
            prov = SCRIPTS_DIR / "health_tracker_provider.py"
            if prov.exists():
                subprocess.run(["python3", str(prov), "reset"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        self.show_toast("Métricas de salud reiniciadas a 0 para todos los días")

    def on_save_health_data(self, _):
        data = self.load_health_data()
        data["calories"] = int(self.spin_cal.get_value())
        data["calories_goal"] = int(self.spin_cal_goal.get_value())
        data["exercise"] = int(self.spin_ex.get_value())
        data["exercise_goal"] = int(self.spin_ex_goal.get_value())
        data["steps"] = int(self.spin_steps.get_value())
        data["steps_goal"] = int(self.spin_steps_goal.get_value())
        data["water"] = round(float(self.spin_water.get_value()), 2)
        data["water_goal"] = round(float(self.spin_water_goal.get_value()), 2)
        data["date"] = datetime.now().strftime("%Y-%m-%d")

        ensure_config_dir()
        with open(HEALTH_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)

        # Notify provider
        threading.Thread(target=self._run_health_refresh, daemon=True).start()
        self.show_toast("Métricas de salud sincronizadas con el widget")

    def _run_health_refresh(self):
        try:
            prov = SCRIPTS_DIR / "health_tracker_provider.py"
            if prov.exists():
                subprocess.run(["python3", str(prov), "get"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    # =========================================================================
    # 📝 PÁGINA 3: NOTAS Y AGENDA
    # =========================================================================
    def build_timetable_page(self) -> Gtk.Widget:
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        content.set_margin_top(20)
        content.set_margin_bottom(20)
        content.set_margin_start(24)
        content.set_margin_end(24)
        scroll.set_child(content)

        tt_data = self.load_timetable_data()

        # ── Grupo 1: Datos de Contexto o Institución ──
        group_meta = Adw.PreferencesGroup()
        group_meta.set_title("Contexto o Institución")
        group_meta.set_description("Personaliza el contexto, universidad o área de trabajo.")

        self.tt_uni_row = Adw.EntryRow()
        self.tt_uni_row.set_title("Siglas / Nombre")
        self.tt_uni_row.set_text(tt_data.get("university", "Notas"))
        group_meta.add(self.tt_uni_row)

        self.tt_career_row = Adw.EntryRow()
        self.tt_career_row.set_title("Subtítulo / Especialidad")
        self.tt_career_row.set_text(tt_data.get("career", "Agenda Diaria"))
        group_meta.add(self.tt_career_row)

        content.append(group_meta)

        # ── Grupo 2: Tareas de Estudio y Trabajo (To-Do) ──
        group_tasks = Adw.PreferencesGroup()
        group_tasks.set_title("Tareas y Pendientes")
        group_tasks.set_description("Gestiona entregas, pendientes y tareas que aparecen en el widget de Notas.")

        self.tasks_list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        group_tasks.add(self.tasks_list_box)

        # Añadir nueva tarea
        add_task_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.new_task_title = Gtk.Entry(placeholder_text="Nueva tarea (ej: Revisar entregas)")
        self.new_task_title.set_hexpand(True)
        self.new_task_tag_combo = Gtk.DropDown.new_from_strings([t[0] for t in TASK_TAGS])
        self.new_task_due = Gtk.Entry(placeholder_text="Vencimiento (ej: Viernes)")
        self.new_task_due.set_size_request(100, -1)

        btn_add_task = Gtk.Button(label="+ Añadir Tarea")
        btn_add_task.connect("clicked", self.on_add_task)

        add_task_box.append(self.new_task_title)
        add_task_box.append(self.new_task_tag_combo)
        add_task_box.append(self.new_task_due)
        add_task_box.append(btn_add_task)
        group_tasks.set_header_suffix(add_task_box)

        self.current_tasks = list(tt_data.get("tasks", []))
        self.rebuild_tasks_list()
        content.append(group_tasks)

        # ── Grupo 3: Horarios y Agenda ──
        group_schedule = Adw.PreferencesGroup()
        group_schedule.set_title("Horarios y Agenda")
        group_schedule.set_description("Configura los horarios o eventos que se muestran en el widget.")

        self.schedule_list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        group_schedule.add(self.schedule_list_box)

        self.current_schedule = list(tt_data.get("schedule", []))
        self.rebuild_schedule_list()
        content.append(group_schedule)

        # ── Grupo 4: Apuntes y Scratchpad de Notas ──
        group_notes = Adw.PreferencesGroup()
        group_notes.set_title("Apuntes y Notas Rápidas")
        group_notes.set_description("Texto libre de recordatorios rápidos que se sincronizan con el widget.")

        notes_scroll = Gtk.ScrolledWindow()
        notes_scroll.set_min_content_height(100)
        self.notes_textview = Gtk.TextView()
        self.notes_textview.set_wrap_mode(Gtk.WrapMode.WORD)
        self.notes_textview.get_buffer().set_text(tt_data.get("notes", ""))
        notes_scroll.set_child(self.notes_textview)
        group_notes.add(notes_scroll)
        content.append(group_notes)

        # Botón Guardar
        btn_save_tt = Gtk.Button(label="Guardar Todo y Sincronizar Widget de Notas & Agenda")
        btn_save_tt.add_css_class("wm-btn-primary")
        btn_save_tt.connect("clicked", self.on_save_timetable)
        content.append(btn_save_tt)

        return scroll

    def load_timetable_data(self) -> dict:
        default_data = {
            "university": "Notas",
            "career": "Agenda Diaria",
            "schedule": [],
            "tasks": [],
            "notes": ""
        }
        if TIMETABLE_FILE.exists():
            try:
                with open(TIMETABLE_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    default_data.update(data)
            except Exception:
                pass
        return default_data

    def rebuild_tasks_list(self):
        while child := self.tasks_list_box.get_first_child():
            self.tasks_list_box.remove(child)

        for task in self.current_tasks:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.add_css_class("wm-event-row")

            chk = Gtk.CheckButton()
            chk.set_active(task.get("done", False))
            chk.connect("toggled", lambda b, tid=task.get("id"): self.on_toggle_task(tid, b.get_active()))
            row.append(chk)

            title_entry = Gtk.Entry(text=task.get("title", ""))
            title_entry.set_hexpand(True)
            title_entry.connect("changed", lambda e, tid=task.get("id"): self.on_rename_task(tid, e.get_text()))
            row.append(title_entry)

            # Tag pill
            tag_lbl = Gtk.Label(label=task.get("tag", "General"))
            tag_lbl.add_css_class("wm-pill")
            col = task.get("tag_color", "#007AFF")
            tag_lbl.set_name(f"pill_{task.get('id')}")
            css = f"#pill_{task.get('id')} {{ background-color: rgba(255,255,255,0.08); color: {col}; }}"
            p = Gtk.CssProvider()
            p.load_from_string(css)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_USER)
            row.append(tag_lbl)

            due_entry = Gtk.Entry(text=task.get("due", "Pendiente"))
            due_entry.set_size_request(90, -1)
            due_entry.connect("changed", lambda e, tid=task.get("id"): self.on_change_task_due(tid, e.get_text()))
            row.append(due_entry)

            del_btn = Gtk.Button(icon_name="user-trash-symbolic")
            del_btn.add_css_class("wm-btn-danger")
            del_btn.connect("clicked", lambda _, tid=task.get("id"): self.on_delete_task(tid))
            row.append(del_btn)

            self.tasks_list_box.append(row)

    def on_toggle_task(self, task_id: str, is_done: bool):
        for t in self.current_tasks:
            if str(t.get("id")) == str(task_id):
                t["done"] = is_done
                break

    def on_rename_task(self, task_id: str, new_title: str):
        for t in self.current_tasks:
            if str(t.get("id")) == str(task_id):
                t["title"] = new_title
                break

    def on_change_task_due(self, task_id: str, new_due: str):
        for t in self.current_tasks:
            if str(t.get("id")) == str(task_id):
                t["due"] = new_due
                break

    def on_delete_task(self, task_id: str):
        self.current_tasks = [t for t in self.current_tasks if str(t.get("id")) != str(task_id)]
        self.rebuild_tasks_list()
        self.show_toast("Tarea eliminada")

    def on_add_task(self, _):
        title = self.new_task_title.get_text().strip()
        if not title:
            return
        tag_idx = self.new_task_tag_combo.get_selected()
        tag_name, tag_col = TASK_TAGS[tag_idx] if tag_idx < len(TASK_TAGS) else ("General", "#007AFF")
        due = self.new_task_due.get_text().strip() or "Pendiente"

        self.current_tasks.insert(0, {
            "id": f"t_{int(datetime.now().timestamp() * 1000)}",
            "title": title,
            "tag": tag_name,
            "tag_color": tag_col,
            "done": False,
            "due": due
        })
        self.new_task_title.set_text("")
        self.new_task_due.set_text("")
        self.rebuild_tasks_list()
        self.show_toast(f"Tarea '{title}' agregada")

    def rebuild_schedule_list(self):
        while child := self.schedule_list_box.get_first_child():
            self.schedule_list_box.remove(child)

        for i, item in enumerate(self.current_schedule):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.add_css_class("wm-event-row")

            day_lbl = Gtk.Label(label=item.get("day_name", "Día"))
            day_lbl.set_css_classes(["bold"])
            day_lbl.set_size_request(80, -1)
            day_lbl.set_halign(Gtk.Align.START)
            row.append(day_lbl)

            sub_entry = Gtk.Entry(text=item.get("subject", ""))
            sub_entry.set_hexpand(True)
            sub_entry.connect("changed", lambda e, idx=i: self._update_schedule_field(idx, "subject", e.get_text()))
            row.append(sub_entry)

            time_entry = Gtk.Entry(text=f"{item.get('start', '18:00')} - {item.get('end', '22:00')}")
            time_entry.set_size_request(110, -1)
            time_entry.connect("changed", lambda e, idx=i: self._update_schedule_time(idx, e.get_text()))
            row.append(time_entry)

            room_entry = Gtk.Entry(text=item.get("room", "Aula 101"))
            room_entry.set_size_request(85, -1)
            room_entry.connect("changed", lambda e, idx=i: self._update_schedule_field(idx, "room", e.get_text()))
            row.append(room_entry)

            prof_entry = Gtk.Entry(text=item.get("professor", "Profesor"))
            prof_entry.set_size_request(110, -1)
            prof_entry.connect("changed", lambda e, idx=i: self._update_schedule_field(idx, "professor", e.get_text()))
            row.append(prof_entry)

            self.schedule_list_box.append(row)

    def _update_schedule_field(self, idx: int, field: str, val: str):
        if idx < len(self.current_schedule):
            self.current_schedule[idx][field] = val

    def _update_schedule_time(self, idx: int, time_str: str):
        if idx < len(self.current_schedule):
            parts = [p.strip() for p in time_str.split("-")]
            if len(parts) >= 2:
                self.current_schedule[idx]["start"] = parts[0]
                self.current_schedule[idx]["end"] = parts[1]

    def on_save_timetable(self, _):
        buf = self.notes_textview.get_buffer()
        start, end = buf.get_bounds()
        notes_text = buf.get_text(start, end, True)

        data = {
            "university": self.tt_uni_row.get_text().strip() or "Notas",
            "career": self.tt_career_row.get_text().strip() or "Agenda Diaria",
            "schedule": self.current_schedule,
            "tasks": self.current_tasks,
            "notes": notes_text
        }
        ensure_config_dir()
        with open(TIMETABLE_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)

        threading.Thread(target=self._run_timetable_refresh, daemon=True).start()
        self.show_toast("Horario y notas guardadas correctamente")

    def _run_timetable_refresh(self):
        try:
            prov = SCRIPTS_DIR / "timetable_provider.py"
            if prov.exists():
                subprocess.run(["python3", str(prov), "get"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

