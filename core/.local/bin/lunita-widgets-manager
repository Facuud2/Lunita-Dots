    def load_git_config(self) -> dict:
        default_cfg = {
            "username": "Facuud2",
            "token": "",
            "repos": ["Lunita-Dots", "Comitas-App", "FocuseAR"],
            "ci_repo": "Comitas-App",
            "local_repo": str(DOTS_DIR),
            "show_ci": True
        }
        if GIT_CONFIG_FILE.exists():
            try:
                with open(GIT_CONFIG_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    default_cfg.update(data)
            except Exception:
                pass
        return default_cfg

    def rebuild_tracked_repos_ui(self):
        while child := self.repos_list_box.get_first_child():
            self.repos_list_box.remove(child)

        for repo in self.tracked_repos:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row.add_css_class("wm-event-row")

            icon = Gtk.Image.new_from_icon_name("folder-symbolic")
            row.append(icon)

            lbl = Gtk.Label(label=repo)
            lbl.set_css_classes(["bold"])
            lbl.set_halign(Gtk.Align.START)
            lbl.set_hexpand(True)
            row.append(lbl)

            del_btn = Gtk.Button(icon_name="user-trash-symbolic")
            del_btn.add_css_class("wm-btn-danger")
            del_btn.set_tooltip_text(f"Quitar {repo} de la lista")
            del_btn.connect("clicked", lambda _, r=repo: self.on_delete_tracked_repo(r))
            row.append(del_btn)

            self.repos_list_box.append(row)

    def on_delete_tracked_repo(self, repo_name: str):
        if repo_name in self.tracked_repos:
            self.tracked_repos.remove(repo_name)
            self.rebuild_tracked_repos_ui()
            self.show_toast(f"Repositorio '{repo_name}' quitado")

    def on_add_tracked_repo(self, _):
        name = self.new_repo_entry.get_text().strip()
        if not name:
            return
        if name not in self.tracked_repos:
            self.tracked_repos.append(name)
            self.new_repo_entry.set_text("")
            self.rebuild_tracked_repos_ui()
            self.show_toast(f"Repositorio '{name}' añadido a la lista")

    def on_save_git_config(self, _):
        cfg = {
            "username": self.git_user_row.get_text().strip() or "Facuud2",
            "token": self.git_token_row.get_text().strip(),
            "repos": self.tracked_repos,
            "ci_repo": self.git_ci_repo_row.get_text().strip() or "Comitas-App",
            "local_repo": self.git_local_row.get_text().strip() or str(DOTS_DIR),
            "show_ci": self.git_show_ci_row.get_active()
        }
        ensure_config_dir()
        with open(GIT_CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)

        cache_file = Path("/tmp/lunita_git_cache.json")
        if cache_file.exists():
            try:
                cache_file.unlink()
            except Exception:
                pass

        threading.Thread(target=self._run_git_refresh, daemon=True).start()
        self.show_toast("Configuración de GitHub guardada correctamente")

    def _run_git_refresh(self):
        try:
            prov_script = SCRIPTS_DIR / "git_activity_provider.py"
            if prov_script.exists():
                subprocess.run(["python3", str(prov_script), "refresh"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    # =========================================================================
    # 🖥️ PÁGINA 5: ESCRITORIO Y CONTROL DE WIDGETS
    # =========================================================================
    def build_desktop_page(self) -> Gtk.Widget:
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        content.set_margin_top(20)
        content.set_margin_bottom(20)
        content.set_margin_start(24)
        content.set_margin_end(24)
        scroll.set_child(content)

        # ── Grupo 1: Servicio Quickshell ──
        group_status = Adw.PreferencesGroup()
        group_status.set_title("Servicio de Widgets")
        group_status.set_description("Control del motor de renderizado y proceso en segundo plano.")

        row_daemon = Adw.ActionRow()
        row_daemon.set_title("Servicio de Widgets Quickshell")
        row_daemon.set_subtitle("Gestiona los widgets dinámicos sobre el escritorio")

        btn_edit_mode = Gtk.Button(label="✏️ Modo Edición")
        btn_edit_mode.set_valign(Gtk.Align.CENTER)
        btn_edit_mode.add_css_class("wm-btn-primary")
        btn_edit_mode.connect("clicked", self.on_toggle_edit_mode)
        row_daemon.add_suffix(btn_edit_mode)

        btn_restart = Gtk.Button(label="🔄 Reiniciar")
        btn_restart.set_valign(Gtk.Align.CENTER)
        btn_restart.add_css_class("wm-btn-secondary")
        btn_restart.connect("clicked", self.on_restart_widgets)
        row_daemon.add_suffix(btn_restart)
        group_status.add(row_daemon)
        content.append(group_status)

        # ── Grupo 2: Clima y Ubicación ──
        group_weather = Adw.PreferencesGroup()
        group_weather.set_title("Ubicación del Clima")
        group_weather.set_description("Define la ciudad utilizada para el widget de reloj y pronóstico.")

        self.weather_city_row = Adw.EntryRow()
        self.weather_city_row.set_title("Ciudad / Región")
        current_loc = "Buenos Aires"
        if WEATHER_LOCATION_FILE.exists():
            try:
                current_loc = WEATHER_LOCATION_FILE.read_text(encoding="utf-8").strip() or "Buenos Aires"
            except Exception:
                pass
        self.weather_city_row.set_text(current_loc)

        btn_save_weather = Gtk.Button(label="💾 Guardar")
        btn_save_weather.set_valign(Gtk.Align.CENTER)
        btn_save_weather.add_css_class("wm-btn-primary")
        btn_save_weather.connect("clicked", self.on_save_weather_location)
        self.weather_city_row.add_suffix(btn_save_weather)

        group_weather.add(self.weather_city_row)
        content.append(group_weather)

        # ── Grupo 3: Cuadrícula y Disposición ──
        group_layout = Adw.PreferencesGroup()
        group_layout.set_title("Cuadrícula y Posiciones")
        group_layout.set_description("Restaura la distribución limpia de los 10 widgets en pantalla si se han movido.")

        row_layout = Adw.ActionRow()
        row_layout.set_title("Restaurar Disposición Óptima por Defecto")
        row_layout.set_subtitle("Alinea todos los widgets a sus coordenadas limpias sin superposiciones")

        btn_reset_grid = Gtk.Button(label="↺ Restaurar Cuadrícula")
        btn_reset_grid.set_valign(Gtk.Align.CENTER)
        btn_reset_grid.add_css_class("wm-btn-secondary")
        btn_reset_grid.connect("clicked", self.on_reset_layout_grid)
        row_layout.add_suffix(btn_reset_grid)
        group_layout.add(row_layout)
        content.append(group_layout)

        # ── Grupo 4: Widgets Visibles en Pantalla (Interruptores) ──
        self.group_active_widgets = Adw.PreferencesGroup()
        self.group_active_widgets.set_title("Widgets Activos en Pantalla")
        self.group_active_widgets.set_description("Activa o desactiva qué widgets deben mostrarse en el escritorio.")

        self.widget_switches = {}
        widgets_info = [
            ("clock", "Reloj y Clima", "Hora analógica, digital y pronóstico de días posteriores", "weather-clouds-symbolic"),
            ("calendar", "Calendario Interactivo", "Eventos diarios, consulta de fechas y citas", "x-office-calendar"),
            ("habits", "Salud y Actividad", "Anillos de actividad (Calorías, Ejercicio, Pasos y Agua)", "emblem-favorite-symbolic"),
            ("timetable", "Notas y Agenda", "Tarjetas de notas rápidas, checklist de tareas y agenda de actividades", "accessories-text-editor-symbolic"),
            ("media", "Reproductor Multimedia", "Portada de álbum, controles y espectro visualizador Cava", "multimedia-audio-player-symbolic"),
            ("battery", "Dispositivos y Batería", "Auriculares Bluetooth y ecosistema conectado con batería", "battery-symbolic"),
            ("git", "Actividad de GitHub", "Heatmap semanal, últimos commits y pipelines CI/CD", "preferences-system-network-symbolic"),
            ("resources", "Monitor de Recursos", "Anillos de uso para CPU, Memoria RAM y Almacenamiento", "utilities-system-monitor-symbolic"),
            ("network", "Monitoreo de Red", "Sparkline de tráfico, velocidades de subida y bajada", "network-wireless-symbolic"),
            ("photos", "Galería de Fotos", "Recuerdos fotográficos rotativos de tu carpeta personal", "camera-photo-symbolic")
        ]

        active_types = self.get_active_widget_types()

        for w_type, w_title, w_desc, w_icon in widgets_info:
            row = Adw.SwitchRow()
            row.set_title(w_title)
            row.set_subtitle(w_desc)
            row.add_prefix(Gtk.Image.new_from_icon_name(w_icon))
            row.set_active(w_type in active_types)
            row.connect("notify::active", lambda r, _, wt=w_type: self.on_toggle_widget_active(wt, r.get_active()))
            self.widget_switches[w_type] = row
            self.group_active_widgets.add(row)

        content.append(self.group_active_widgets)

        return scroll

    def on_save_weather_location(self, _):
        city = self.weather_city_row.get_text().strip() or "Buenos Aires"
        ensure_config_dir()
        WEATHER_LOCATION_FILE.write_text(city, encoding="utf-8")

        # Purge cache
        cache_file = Path("/tmp/lunita_weather_cache.json")
        if cache_file.exists():
            try:
                cache_file.unlink()
            except Exception:
                pass

        # Trigger weather provider
        def _prov():
            try:
                subprocess.run(["python3", str(SCRIPTS_DIR / "weather_provider.py"), "get"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
        threading.Thread(target=_prov, daemon=True).start()
        self.show_toast(f"Ubicación del clima actualizada a '{city}'")

    def get_active_widget_types(self) -> set:
        if not LAYOUT_FILE.exists():
            return set()
        try:
            with open(LAYOUT_FILE, "r", encoding="utf-8") as f:
                items = json.load(f)
                return {item.get("type") for item in items if item.get("type")}
        except Exception:
            return set()

    def on_toggle_widget_active(self, widget_type: str, is_active: bool):
        if not LAYOUT_FILE.exists():
            return
        try:
            with open(LAYOUT_FILE, "r", encoding="utf-8") as f:
                items = json.load(f)
        except Exception:
            items = []

        existing = [item for item in items if item.get("type") == widget_type]

        if is_active and not existing:
            # Add widget
            def_item = WIDGET_DEFAULTS.get(widget_type, {"type": widget_type, "size": "small", "width": 170, "height": 170, "x": 1520, "y": 200})
            new_item = dict(def_item)
            new_item["id"] = f"{widget_type}_{int(datetime.now().timestamp() % 1000)}"
            items.append(new_item)
            self.show_toast(f"Widget '{widget_type}' activado")
        elif not is_active and existing:
            # Remove widget
            items = [item for item in items if item.get("type") != widget_type]
            self.show_toast(f"Widget '{widget_type}' ocultado")

        ensure_config_dir()
        with open(LAYOUT_FILE, "w", encoding="utf-8") as f:
            json.dump(items, f, ensure_ascii=False, indent=2)

        self.on_restart_widgets(None)

    def _resolve_widgets_qml_dir(self) -> Path:
        candidates = [
            WIDGETS_DIR,
            DOTS_DIR / "core/.config/quickshell/widgets",
            DOTS_DIR / "themes/macos-theme/.config/quickshell/widgets",
        ]
        for cand in candidates:
            if (cand / "shell.qml").is_file():
                return cand
        return WIDGETS_DIR

    def on_toggle_edit_mode(self, _):
        toggle_bin = SCRIPT_DIR / "lunita-widgets-toggle"
        cmd = [str(toggle_bin)] if toggle_bin.is_file() else ["lunita-widgets-toggle"]
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.show_toast("Modo de edición de widgets alternado en el escritorio")

    def on_restart_widgets(self, _):
        def _restart():
            subprocess.run(["pkill", "-f", "quickshell.*widgets"], check=False)
            cfg_path = self._resolve_widgets_qml_dir()
            subprocess.Popen(["quickshell", "-d", "-n", "-p", str(cfg_path)])

        threading.Thread(target=_restart, daemon=True).start()
        self.show_toast("Daemon de widgets reiniciado correctamente")

    def on_reset_layout_grid(self, _):
        default_layout = [
            {"id": "battery_303", "type": "battery", "x": 560, "y": 140, "size": "small", "width": 170, "height": 170},
            {"id": "git_90", "type": "git", "x": 744, "y": 140, "size": "small", "width": 170, "height": 170},
            {"id": "habits_144", "type": "habits", "x": 560, "y": 324, "size": "small", "width": 170, "height": 170},
            {"id": "timetable_122", "type": "timetable", "x": 744, "y": 324, "size": "small", "width": 170, "height": 170},
            {"id": "media_612", "type": "media", "x": 560, "y": 508, "size": "medium", "width": 354, "height": 170},
            {"id": "cal", "type": "calendar", "x": 1520, "y": 50, "size": "small", "width": 170, "height": 170},
            {"id": "net", "type": "network", "x": 1704, "y": 50, "size": "small", "width": 170, "height": 170},
            {"id": "sys", "type": "resources", "x": 1520, "y": 234, "size": "small", "width": 170, "height": 170},
            {"id": "clk", "type": "clock", "x": 1704, "y": 234, "size": "small", "width": 170, "height": 170},
            {"id": "pho", "type": "photos", "x": 1520, "y": 418, "size": "medium", "width": 354, "height": 176}
        ]
        ensure_config_dir()
        with open(LAYOUT_FILE, "w", encoding="utf-8") as f:
            json.dump(default_layout, f, ensure_ascii=False, indent=2)

        try:
            prov = SCRIPTS_DIR / "health_tracker_provider.py"
            if prov.exists():
                subprocess.run(["python3", str(prov), "reset"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        # Update switches
        active = {i["type"] for i in default_layout}
        for wt, sw in self.widget_switches.items():
            sw.set_active(wt in active)

        self.on_restart_widgets(None)
        self.show_toast("Cuadrícula restablecida y widgets alineados")

def main():
    app = WidgetsManagerApp()
    return app.run(sys.argv)

if __name__ == "__main__":
    sys.exit(main())
