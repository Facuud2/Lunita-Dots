def ensure_config_dir():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)

class WidgetsManagerApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="org.lunita.WidgetsManager",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
        )
        self.win = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        style_mgr = self.get_style_manager()
        style_mgr.set_color_scheme(Adw.ColorScheme.FORCE_DARK)

    def do_activate(self):
        self._activate_with_tab("calendar")

    def do_command_line(self, command_line):
        args = command_line.get_arguments()
        target_tab = "calendar"
        i = 1
        while i < len(args):
            arg = args[i]
            if arg in ["--tab", "-t"] and i + 1 < len(args):
                target_tab = args[i + 1]
                i += 2
            elif arg.startswith("--tab="):
                target_tab = arg.split("=", 1)[1]
                i += 1
            else:
                i += 1

        self._activate_with_tab(target_tab)
        return 0

    def _activate_with_tab(self, target_tab="calendar"):
        windows = self.get_windows()
        if not windows:
            self.win = WidgetsManagerWindow(application=self, initial_tab=target_tab)
        else:
            self.win = windows[0]
            if target_tab in ["calendar", "health", "timetable", "github", "desktop"]:
                self.win.view_stack.set_visible_child_name(target_tab)

        self.win.present()
        try:
            subprocess.run(
                ["hyprctl", "dispatch", "focuswindow", "class:org.lunita.WidgetsManager"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
        except Exception:
            pass

class WidgetsManagerWindow(Adw.ApplicationWindow):
    def __init__(self, initial_tab="calendar", **kwargs):
        super().__init__(**kwargs)
        self.initial_tab = initial_tab
        self.set_title("Gestor de Widgets")
        self.set_default_size(1020, 740)
        ensure_config_dir()

        self.setup_css()
        self.build_ui()
        if self.initial_tab in ["calendar", "health", "timetable", "github", "desktop"]:
            self.view_stack.set_visible_child_name(self.initial_tab)

